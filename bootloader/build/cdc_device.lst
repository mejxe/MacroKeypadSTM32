 101:libs/tinyusb/class/cdc/cdc_device.c **** TU_ATTR_ALWAYS_INLINE static inline uint8_t find_cdc_itf(uint8_t ep_addr) {
 102:libs/tinyusb/class/cdc/cdc_device.c ****   for (uint8_t idx = 0; idx < CFG_TUD_CDC; idx++) {
 103:libs/tinyusb/class/cdc/cdc_device.c ****     const cdcd_interface_t *p_cdc = &_cdcd_itf[idx];
 104:libs/tinyusb/class/cdc/cdc_device.c ****     if (ep_addr == p_cdc->rx_stream.ep_addr || ep_addr == p_cdc->tx_stream.ep_addr ||
 105:libs/tinyusb/class/cdc/cdc_device.c ****         (ep_addr == p_cdc->ep_notify && ep_addr != 0)) {
 106:libs/tinyusb/class/cdc/cdc_device.c ****       return idx;
 107:libs/tinyusb/class/cdc/cdc_device.c ****     }
 108:libs/tinyusb/class/cdc/cdc_device.c ****   }
 109:libs/tinyusb/class/cdc/cdc_device.c ****   return TUSB_INDEX_INVALID_8;
 110:libs/tinyusb/class/cdc/cdc_device.c **** }
