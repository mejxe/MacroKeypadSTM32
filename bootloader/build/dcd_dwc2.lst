 174:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // MCU specific PHY init, called BEFORE core reset
 175:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // - dwc2 3.30a (H5) use USB_HS_PHYC
 176:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // - dwc2 4.11a (U5) use femtoPHY
 177:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // - dwc2 x.xxx (WBA) use USB_OTG_HS
 178:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** static inline void dwc2_phy_init(dwc2_regs_t* dwc2, uint8_t hs_phy_type) {
 179:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   if (hs_phy_type == GHWCFG2_HSPHY_NOT_SUPPORTED) {
 180:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // Enable on-chip FS PHY
 181:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     dwc2->stm32_gccfg |= STM32_GCCFG_PWRDWN;
 182:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** 
 183:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // https://community.st.com/t5/stm32cubemx-mcus/why-stm32h743-usb-fs-doesn-t-work-if-freertos-t
 184:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // H7 running on full-speed phy need to disable ULPI clock in sleep mode.
 185:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // Otherwise, USB won't work when mcu executing WFI/WFE instruction i.e tick-less RTOS.
 186:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // Note: there may be other family that is affected by this, but only H7 and F7 is tested so fa
 187:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     #if defined(USB_OTG_FS_PERIPH_BASE) && defined(RCC_AHB1LPENR_USB2OTGFSULPILPEN)
 188:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     if ( USB_OTG_FS_PERIPH_BASE == (uint32_t) dwc2 ) {
