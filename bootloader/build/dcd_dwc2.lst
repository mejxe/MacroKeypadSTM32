 395:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     dep->diepctl = depctl.value; // enable endpoint
 396:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   } else
 397:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   #endif
 398:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   {
 399:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   #if CFG_TUD_DWC2_SLAVE_ENABLE
