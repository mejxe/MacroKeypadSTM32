 151:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** 
 152:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** TU_ATTR_ALWAYS_INLINE static inline void dwc2_int_set(uint8_t rhport, tusb_role_t role, bool enable
 153:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   (void) role;
 154:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   const IRQn_Type irqn = (IRQn_Type) _dwc2_controller[rhport].irqnum;
 155:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   if (enabled) {
 156:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     NVIC_EnableIRQ(irqn);
 157:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   } else {
 158:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     NVIC_DisableIRQ(irqn);
 159:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   }
 160:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** }
 161:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** 
 162:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** #define dwc2_dcd_int_enable(_rhport)  dwc2_int_set(_rhport, TUSB_ROLE_DEVICE, true)
