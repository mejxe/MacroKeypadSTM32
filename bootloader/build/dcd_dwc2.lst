 270:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // MCU specific PHY update, it is called AFTER init() and core reset
 271:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** static inline void dwc2_phy_update(dwc2_regs_t* dwc2, uint8_t hs_phy_type) {
 272:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   // used to set turnaround time for fullspeed, nothing to do in highspeed mode
 273:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   if (hs_phy_type == GHWCFG2_HSPHY_NOT_SUPPORTED) {
 274:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // Turnaround timeout depends on the AHB clock dictated by STM32 Reference Manual
 275:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     uint32_t turnaround;
 276:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** 
 277:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     if (SystemCoreClock >= 32000000u) {
 278:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0x6u;
 279:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     } else if (SystemCoreClock >= 27500000u) {
 280:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0x7u;
 281:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     } else if (SystemCoreClock >= 24000000u) {
 282:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0x8u;
 283:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     } else if (SystemCoreClock >= 21800000u) {
 284:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0x9u;
 285:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 286:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     else if (SystemCoreClock >= 20000000u) {
 287:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0xAu;
 288:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 289:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     else if (SystemCoreClock >= 18500000u) {
 290:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0xBu;
 291:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 292:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     else if (SystemCoreClock >= 17200000u) {
 293:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0xCu;
 294:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 295:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     else if (SystemCoreClock >= 16000000u) {
 296:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0xDu;
 297:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 298:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     else if (SystemCoreClock >= 15000000u) {
 299:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0xEu;
 300:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 301:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     else {
 302:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****       turnaround = 0xFu;
 303:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     }
 304:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** 
 305:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     dwc2->gusbcfg = (dwc2->gusbcfg & ~GUSBCFG_TRDT_Msk) | (turnaround << GUSBCFG_TRDT_Pos);
 306:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   }
 307:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** }
