 133:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** //--------------------------------------------------------------------+
 134:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** // Data FIFO
 135:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** //--------------------------------------------------------------------+
 136:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 137:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 138:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** /* Device Data FIFO scheme
 139:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   The controller has a single SPRAM of otg_dfifo_depth 32-bit words shared between all FIFOs and op
 140:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   otg_dfifo_depth = ghwcfg3.dfifo_depth + EP_LOC_CNT. It is split up into:
 141:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 142:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   - EPInfo: for storing DMA address registers (DxEPDMAn), only required when DMA is used.
 143:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     gdfifocfg.EPINFOBASE and gdfifocfg.GDFIFOCfg must be configured before gahbcfg.dmaen is set.
 144:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     The number of words needed per endpoint direction depends on the DMA mode used at runtime:
 145:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       - Buffer DMA mode: 1 word per endpoint direction
 146:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       - Scatter/Gather DMA mode: 4 words per endpoint direction
 147:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   - TX FIFO: one fifo for each IN endpoint. Size is dynamic depending on packet size, starting from
 148:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   - Shared RX FIFO: a shared fifo for all OUT endpoints. Typically, can hold up to 2 packets of the
 149:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 150:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   We allocate TX FIFOs from top to bottom (using a top pointer), this to allow the RX FIFO to grow 
 151:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   possible since the free space is located between the RX and TX FIFOs.
 152:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 153:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****    --------------- otg_dfifo_depth
 154:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |  EPInfo      |   DxEPDMAn (DMA only, sized per runtime DMA mode)
 155:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |-------------|-- gdfifocfg.EPINFOBASE (start of EPInfo; FIFO space sized by GDFIFOCFG)
 156:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   | IN FIFO 0   |       control EP
 157:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |-------------|
 158:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   | IN FIFO 1   |
 159:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |-------------|
 160:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |   . . . .   |
 161:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |-------------|
 162:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   | IN FIFO n   |
ARM GAS  /tmp//ccVVfFmF.s 			page 51


 163:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |-------------|
 164:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |    FREE     |
 165:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |-------------|-- GRXFSIZ (expandable)
 166:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   |  OUT FIFO   |
 167:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   | ( Shared )  |
 168:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   --------------- 0
 169:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 170:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   According to "FIFO RAM allocation" section in RM, FIFO RAM are allocated as follows (each word 32
 171:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   - Each EP IN needs at least max packet size
 172:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   - All EP OUT shared a unique OUT FIFO which uses (for Slave or Buffer DMA, Scatt/Gather DMA use d
 173:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     - 13 for setup packets + control words (up to 3 setup packets).
 174:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     - 1 for global NAK (not required/used here).
 175:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     - Largest-EPsize/4 + 1. (FS: 64 bytes, HS: 512 bytes). Recommended is  "2 x (Largest-EPsize/4 +
 176:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     - 2 for each used OUT endpoint.
 177:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 178:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     Therefore, GRXFSIZ = 13 + 1 + 2 x (Largest-EPsize/4 + 1) + 2 x EPOUTnum
 179:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** */
 180:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 181:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** TU_ATTR_ALWAYS_INLINE static inline uint16_t calc_device_grxfsiz(uint16_t largest_ep_size, uint8_t 
 182:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   return (uint16_t)(13 + 1 + 2 * ((largest_ep_size / 4) + 1) + 2 * ep_count);
 183:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** }
