 401:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 402:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     if (dir == TUSB_DIR_IN && total_bytes != 0) {
 403:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       const uint16_t xferred_bytes = epin_write_tx_fifo(dwc2, epnum);
 404:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 405:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       // Enable TXFE interrupt if there are still data to be sent
 406:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       // EP0 only sends one packet at a time, so no need to check for EP0
 407:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       if ((epnum != 0) && (xfer->total_len - xferred_bytes > 0)) {
 408:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****          dwc2->diepempmsk |= (1u << epnum);
 409:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       }
 410:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     }
 411:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   #endif
 412:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   }
