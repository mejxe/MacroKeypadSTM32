 441:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   uint32_t dcfg = dwc2->dcfg & ~DCFG_DSPD_Msk;
 442:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   if (is_hs_phy) {
 443:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     // dcfg Highspeed's mask is 0
 444:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 445:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     // XCVRDLY: transceiver delay between xcvr_sel and txvalid during device chirp is required
