 388:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   #if CFG_TUD_DWC2_DMA_ENABLE
 389:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   const bool is_dma = dma_device_enabled(dwc2);
 390:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   if(is_dma) {
 391:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     if (dir == TUSB_DIR_IN && total_bytes != 0) {
 392:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       dcd_dcache_clean(xfer->buffer, total_bytes);
 393:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     }
