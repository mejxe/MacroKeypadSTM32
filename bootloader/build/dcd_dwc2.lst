 344:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** // Since this function returns void, it is not possible to return a boolean success message
 345:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** // We must make sure that this function is not called when the EP is disabled
 346:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** // Must be called from critical section
 347:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** static void edpt_schedule_packets(uint8_t rhport, const uint8_t epnum, const uint8_t dir) {
 348:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   dwc2_regs_t* dwc2 = DWC2_REG(rhport);
 349:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   xfer_ctl_t* const xfer = XFER_CTL_BASE(epnum, dir);
 350:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   dwc2_dep_t* dep = &dwc2->ep[dir == TUSB_DIR_IN ? 0 : 1][epnum];
 351:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 352:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   uint16_t num_packets;
 353:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   uint16_t total_bytes;
 354:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 355:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   // EP0 is limited to one packet per xfer
 356:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   if (epnum == 0) {
 357:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     total_bytes = tu_min16(_dcd_data.ep0_pending[dir], CFG_TUD_ENDPOINT0_SIZE);
 358:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     _dcd_data.ep0_pending[dir] -= total_bytes;
 359:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     num_packets = 1;
 360:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   } else {
 361:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     total_bytes = xfer->total_len;
 362:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     num_packets = (uint16_t)tu_div_ceil(total_bytes, xfer->max_size);
 363:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     if (num_packets == 0) {
 364:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       num_packets = 1; // zero length packet still count as 1
 365:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     }
 366:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   }
 367:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 368:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   // transfer size: A full OUT transfer (multiple packets, possibly) triggers XFRC.
 369:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   dwc2_ep_tsize_t deptsiz = {.value = 0};
 370:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   deptsiz.xfer_size = total_bytes;
 371:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   deptsiz.packet_count = num_packets;
 372:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   dep->tsiz = deptsiz.value;
 373:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c **** 
 374:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   // control
 375:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   dwc2_depctl_t depctl = {.value = dep->ctl};
 376:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   depctl.clear_nak = 1;
 377:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   depctl.enable = 1;
 378:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   if (depctl.type == DEPCTL_EPTYPE_ISOCHRONOUS) {
 379:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     const dwc2_dsts_t dsts = {.value = dwc2->dsts};
 380:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     const uint32_t odd_now = dsts.frame_number & 1u;
 381:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     if (odd_now != 0) {
ARM GAS  /tmp//ccVVfFmF.s 			page 91


 382:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       depctl.set_data0_iso_even = 1;
 383:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     } else {
 384:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****       depctl.set_data1_iso_odd = 1;
 385:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****     }
 386:libs/tinyusb/portable/synopsys/dwc2/dcd_dwc2.c ****   }
