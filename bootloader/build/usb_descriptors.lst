 129:Core/Src/usb_descriptors.c **** // Invoked when received GET DEVICE QUALIFIER DESCRIPTOR request
 130:Core/Src/usb_descriptors.c **** // Application return pointer to descriptor, whose contents must exist long
 131:Core/Src/usb_descriptors.c **** // enough for transfer to complete. device_qualifier descriptor describes
 132:Core/Src/usb_descriptors.c **** // information about a high-speed capable device that would change if the device
 133:Core/Src/usb_descriptors.c **** // were operating at the other speed. If not highspeed capable stall this
 134:Core/Src/usb_descriptors.c **** // request.
 135:Core/Src/usb_descriptors.c **** uint8_t const *tud_descriptor_device_qualifier_cb(void)
 136:Core/Src/usb_descriptors.c **** {
 137:Core/Src/usb_descriptors.c ****   return (uint8_t const *)&desc_device_qualifier;
 138:Core/Src/usb_descriptors.c **** }
 139:Core/Src/usb_descriptors.c **** 
 140:Core/Src/usb_descriptors.c **** // Invoked when received GET OTHER SEED CONFIGURATION DESCRIPTOR request
 141:Core/Src/usb_descriptors.c **** // Application return pointer to descriptor, whose contents must exist long
 142:Core/Src/usb_descriptors.c **** // enough for transfer to complete Configuration descriptor in the other speed
 143:Core/Src/usb_descriptors.c **** // e.g if high speed then this is for full speed and vice versa
 144:Core/Src/usb_descriptors.c **** uint8_t const *tud_descriptor_other_speed_configuration_cb(uint8_t index)
 145:Core/Src/usb_descriptors.c **** {
 146:Core/Src/usb_descriptors.c ****   (void)index; // for multiple configurations
 147:Core/Src/usb_descriptors.c **** 
 148:Core/Src/usb_descriptors.c ****   // if link speed is high return fullspeed config, and vice versa
 149:Core/Src/usb_descriptors.c ****   // Note: the descriptor type is OTHER_SPEED_CONFIG instead of CONFIG
 150:Core/Src/usb_descriptors.c ****   memcpy(desc_other_speed_config,
 151:Core/Src/usb_descriptors.c ****          (tud_speed_get() == TUSB_SPEED_HIGH) ? desc_fs_configuration
 152:Core/Src/usb_descriptors.c ****                                               : desc_hs_configuration,
 153:Core/Src/usb_descriptors.c ****          CONFIG_TOTAL_LEN);
 154:Core/Src/usb_descriptors.c **** 
 155:Core/Src/usb_descriptors.c ****   desc_other_speed_config[1] = TUSB_DESC_OTHER_SPEED_CONFIG;
 156:Core/Src/usb_descriptors.c **** 
 157:Core/Src/usb_descriptors.c ****   return desc_other_speed_config;
 158:Core/Src/usb_descriptors.c **** }
 159:Core/Src/usb_descriptors.c **** 
 160:Core/Src/usb_descriptors.c **** #endif // highspeed
 161:Core/Src/usb_descriptors.c **** 
