 300:libs/tinyusb/tusb.c **** //--------------------------------------------------------------------+
 301:libs/tinyusb/tusb.c **** // Endpoint Stream Helper for both Host and Device stack
 302:libs/tinyusb/tusb.c **** //--------------------------------------------------------------------+
 303:libs/tinyusb/tusb.c **** 
 304:libs/tinyusb/tusb.c **** bool tu_edpt_stream_init(tu_edpt_stream_t *s, bool is_host, bool is_tx, bool overwritable, void *ff
 305:libs/tinyusb/tusb.c ****                          uint16_t ff_bufsize, uint8_t *ep_buf) {
 306:libs/tinyusb/tusb.c ****   (void) is_tx;
 307:libs/tinyusb/tusb.c **** 
 308:libs/tinyusb/tusb.c ****   if (ff_buf == NULL || ff_bufsize == 0) {
 309:libs/tinyusb/tusb.c ****     return false;
 310:libs/tinyusb/tusb.c ****   }
 311:libs/tinyusb/tusb.c **** 
 312:libs/tinyusb/tusb.c ****   s->is_host = is_host;
 313:libs/tinyusb/tusb.c ****   tu_fifo_config(&s->ff, ff_buf, ff_bufsize, overwritable);
