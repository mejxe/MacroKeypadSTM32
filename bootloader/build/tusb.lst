 173:libs/tinyusb/tusb.c **** 
 174:libs/tinyusb/tusb.c **** uint8_t const* tu_desc_find(uint8_t const* desc, uint8_t const* end, uint8_t byte1) {
 175:libs/tinyusb/tusb.c ****   while (desc + 1 < end) {
 176:libs/tinyusb/tusb.c ****     if (desc[1] == byte1) {
 177:libs/tinyusb/tusb.c ****       return desc;
 178:libs/tinyusb/tusb.c ****     }
 179:libs/tinyusb/tusb.c ****     desc += desc[DESC_OFFSET_LEN];
 180:libs/tinyusb/tusb.c ****   }
 181:libs/tinyusb/tusb.c ****   return NULL;
 182:libs/tinyusb/tusb.c **** }
 183:libs/tinyusb/tusb.c **** 
 184:libs/tinyusb/tusb.c **** uint8_t const* tu_desc_find2(uint8_t const* desc, uint8_t const* end, uint8_t byte1, uint8_t byte2)
 185:libs/tinyusb/tusb.c ****   while (desc + 2 < end) {
 186:libs/tinyusb/tusb.c ****     if (desc[1] == byte1 && desc[2] == byte2) {
 187:libs/tinyusb/tusb.c ****       return desc;
 188:libs/tinyusb/tusb.c ****     }
 189:libs/tinyusb/tusb.c ****     desc += desc[DESC_OFFSET_LEN];
 190:libs/tinyusb/tusb.c ****   }
 191:libs/tinyusb/tusb.c ****   return NULL;
 192:libs/tinyusb/tusb.c **** }
 193:libs/tinyusb/tusb.c **** 
 194:libs/tinyusb/tusb.c **** uint8_t const* tu_desc_find3(uint8_t const* desc, uint8_t const* end, uint8_t byte1, uint8_t byte2,
 195:libs/tinyusb/tusb.c ****   while (desc + 3 < end) {
 196:libs/tinyusb/tusb.c ****     if (desc[1] == byte1 && desc[2] == byte2 && desc[3] == byte3) {
 197:libs/tinyusb/tusb.c ****       return desc;
 198:libs/tinyusb/tusb.c ****     }
 199:libs/tinyusb/tusb.c ****     desc += desc[DESC_OFFSET_LEN];
 200:libs/tinyusb/tusb.c ****   }
 201:libs/tinyusb/tusb.c ****   return NULL;
ARM GAS  /tmp//cck2K2Hm.s 			page 5


