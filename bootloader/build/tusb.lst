  99:libs/tinyusb/tusb.c ****     TU_ASSERT(tud_rhport_init(rhport, rh_init));
 100:libs/tinyusb/tusb.c ****   }
 101:libs/tinyusb/tusb.c ****   #endif
 102:libs/tinyusb/tusb.c **** 
 103:libs/tinyusb/tusb.c ****   #if CFG_TUH_ENABLED
 104:libs/tinyusb/tusb.c ****   if (rh_init->role == TUSB_ROLE_HOST) {
 105:libs/tinyusb/tusb.c ****     TU_ASSERT(tuh_rhport_init(rhport, rh_init));
 106:libs/tinyusb/tusb.c ****   }
 107:libs/tinyusb/tusb.c ****   #endif
 108:libs/tinyusb/tusb.c **** 
 109:libs/tinyusb/tusb.c ****   return true;
 110:libs/tinyusb/tusb.c **** }
