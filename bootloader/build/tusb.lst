  88:libs/tinyusb/tusb.c **** 
  89:libs/tinyusb/tusb.c ****     return true;
  90:libs/tinyusb/tusb.c ****   }
  91:libs/tinyusb/tusb.c ****   #endif
  92:libs/tinyusb/tusb.c **** 
  93:libs/tinyusb/tusb.c ****   // new API with explicit rhport and role
  94:libs/tinyusb/tusb.c ****   TU_ASSERT(rhport < TUP_USBIP_CONTROLLER_NUM && rh_init->role != TUSB_ROLE_INVALID);
  95:libs/tinyusb/tusb.c ****   _tusb_rhport_role[rhport] = rh_init->role;
  96:libs/tinyusb/tusb.c **** 
