  68:libs/tinyusb/tusb.c ****   if (rh_init == NULL) {
  69:libs/tinyusb/tusb.c ****     #if CFG_TUD_ENABLED && defined(TUD_OPT_RHPORT)
  70:libs/tinyusb/tusb.c ****     // init device stack CFG_TUSB_RHPORTx_MODE must be defined
  71:libs/tinyusb/tusb.c ****     const tusb_rhport_init_t dev_init = {
  72:libs/tinyusb/tusb.c ****       .role = TUSB_ROLE_DEVICE,
  73:libs/tinyusb/tusb.c ****       .speed = TUD_OPT_HIGH_SPEED ? TUSB_SPEED_HIGH : TUSB_SPEED_FULL
  74:libs/tinyusb/tusb.c ****     };
  75:libs/tinyusb/tusb.c ****     TU_ASSERT ( tud_rhport_init(TUD_OPT_RHPORT, &dev_init) );
  76:libs/tinyusb/tusb.c ****     _tusb_rhport_role[TUD_OPT_RHPORT] = TUSB_ROLE_DEVICE;
  77:libs/tinyusb/tusb.c ****     #endif
  78:libs/tinyusb/tusb.c **** 
  79:libs/tinyusb/tusb.c ****     #if CFG_TUH_ENABLED && defined(TUH_OPT_RHPORT)
  80:libs/tinyusb/tusb.c ****     // init host stack CFG_TUSB_RHPORTx_MODE must be defined
  81:libs/tinyusb/tusb.c ****     const tusb_rhport_init_t host_init = {
  82:libs/tinyusb/tusb.c ****       .role = TUSB_ROLE_HOST,
  83:libs/tinyusb/tusb.c ****       .speed = TUH_OPT_HIGH_SPEED ? TUSB_SPEED_HIGH : TUSB_SPEED_FULL
  84:libs/tinyusb/tusb.c ****     };
  85:libs/tinyusb/tusb.c ****     TU_ASSERT( tuh_rhport_init(TUH_OPT_RHPORT, &host_init) );
  86:libs/tinyusb/tusb.c ****     _tusb_rhport_role[TUH_OPT_RHPORT] = TUSB_ROLE_HOST;
  87:libs/tinyusb/tusb.c ****     #endif
