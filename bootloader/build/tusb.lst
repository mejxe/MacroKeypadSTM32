 242:libs/tinyusb/common/tusb_fifo.h **** // return overflowable count (index difference), which can be used to determine both fifo count and
 243:libs/tinyusb/common/tusb_fifo.h **** TU_ATTR_ALWAYS_INLINE static inline uint16_t tu_ff_overflow_count(uint16_t depth, uint16_t wr_idx, 
 244:libs/tinyusb/common/tusb_fifo.h ****   const int32_t diff = (int32_t)wr_idx - (int32_t)rd_idx;
 245:libs/tinyusb/common/tusb_fifo.h ****   if (diff >= 0) {
 246:libs/tinyusb/common/tusb_fifo.h ****     return (uint16_t)diff;
 247:libs/tinyusb/common/tusb_fifo.h ****   } else {
 248:libs/tinyusb/common/tusb_fifo.h ****     return (uint16_t)(2 * depth + diff);
 249:libs/tinyusb/common/tusb_fifo.h ****   }
 250:libs/tinyusb/common/tusb_fifo.h **** }
 251:libs/tinyusb/common/tusb_fifo.h **** 
 252:libs/tinyusb/common/tusb_fifo.h **** // return remaining slot in fifo
 253:libs/tinyusb/common/tusb_fifo.h **** TU_ATTR_ALWAYS_INLINE static inline uint16_t tu_ff_remaining_local(uint16_t depth, uint16_t wr_idx,
 254:libs/tinyusb/common/tusb_fifo.h ****   const uint16_t ovf_count = tu_ff_overflow_count(depth, wr_idx, rd_idx);
 255:libs/tinyusb/common/tusb_fifo.h ****   return (depth > ovf_count) ? (depth - ovf_count) : 0;
 256:libs/tinyusb/common/tusb_fifo.h **** }
