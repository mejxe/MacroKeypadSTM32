 122:libs/tinyusb/tusb.c ****   if (tuh_inited()) {
 123:libs/tinyusb/tusb.c ****     ret = true;
 124:libs/tinyusb/tusb.c ****   }
 125:libs/tinyusb/tusb.c ****   #endif
