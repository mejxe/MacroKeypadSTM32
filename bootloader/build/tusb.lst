 204:libs/tinyusb/tusb.c **** //--------------------------------------------------------------------+
 205:libs/tinyusb/tusb.c **** // Endpoint Helper for both Host and Device stack
 206:libs/tinyusb/tusb.c **** //--------------------------------------------------------------------+
 207:libs/tinyusb/tusb.c **** 
 208:libs/tinyusb/tusb.c **** bool tu_edpt_claim(volatile uint8_t* ep_state, osal_mutex_t mutex) {
 209:libs/tinyusb/tusb.c ****   (void) mutex;
 210:libs/tinyusb/tusb.c **** 
 211:libs/tinyusb/tusb.c ****   // pre-check to help reducing mutex lock
 212:libs/tinyusb/tusb.c ****   TU_VERIFY((*ep_state & (TU_EDPT_STATE_BUSY | TU_EDPT_STATE_CLAIMED)) == 0);
 213:libs/tinyusb/tusb.c ****   (void) osal_mutex_lock(mutex, OSAL_TIMEOUT_WAIT_FOREVER);
 214:libs/tinyusb/tusb.c **** 
 215:libs/tinyusb/tusb.c ****   // can only claim the endpoint if it is not busy and not claimed yet.
 216:libs/tinyusb/tusb.c ****   bool const available = (*ep_state & (TU_EDPT_STATE_BUSY | TU_EDPT_STATE_CLAIMED)) == 0;
 217:libs/tinyusb/tusb.c ****   if (available) {
 218:libs/tinyusb/tusb.c ****     *ep_state |= TU_EDPT_STATE_CLAIMED;
 219:libs/tinyusb/tusb.c ****   }
 220:libs/tinyusb/tusb.c **** 
 221:libs/tinyusb/tusb.c ****   (void) osal_mutex_unlock(mutex);
 222:libs/tinyusb/tusb.c ****   return available;
 223:libs/tinyusb/tusb.c **** }
 224:libs/tinyusb/tusb.c **** 
 225:libs/tinyusb/tusb.c **** bool tu_edpt_release(volatile uint8_t* ep_state, osal_mutex_t mutex) {
 226:libs/tinyusb/tusb.c ****   (void) mutex;
 227:libs/tinyusb/tusb.c ****   (void) osal_mutex_lock(mutex, OSAL_TIMEOUT_WAIT_FOREVER);
 228:libs/tinyusb/tusb.c **** 
 229:libs/tinyusb/tusb.c ****   // can only release the endpoint if it is claimed and not busy
 230:libs/tinyusb/tusb.c ****   bool const ret = (*ep_state & (TU_EDPT_STATE_CLAIMED | TU_EDPT_STATE_BUSY)) == TU_EDPT_STATE_CLAI
 231:libs/tinyusb/tusb.c ****   if (ret) {
 232:libs/tinyusb/tusb.c ****     *ep_state &= (uint8_t) ~TU_EDPT_STATE_CLAIMED;
 233:libs/tinyusb/tusb.c ****   }
 234:libs/tinyusb/tusb.c **** 
 235:libs/tinyusb/tusb.c ****   (void) osal_mutex_unlock(mutex);
 236:libs/tinyusb/tusb.c ****   return ret;
 237:libs/tinyusb/tusb.c **** }
 238:libs/tinyusb/tusb.c **** 
 239:libs/tinyusb/tusb.c **** #if CFG_TUSB_DEBUG
 240:libs/tinyusb/tusb.c **** bool tu_edpt_validate(const tusb_desc_endpoint_t *desc_ep, tusb_speed_t speed) {
 241:libs/tinyusb/tusb.c ****   const uint16_t max_packet_size = tu_edpt_packet_size(desc_ep);
 242:libs/tinyusb/tusb.c ****   TU_LOG2("  Open EP %02X with Size = %u\r\n", desc_ep->bEndpointAddress, max_packet_size);
 243:libs/tinyusb/tusb.c ****   TU_ASSERT(max_packet_size > 0);
 244:libs/tinyusb/tusb.c **** 
 245:libs/tinyusb/tusb.c ****   switch (desc_ep->bmAttributes.xfer) {
 246:libs/tinyusb/tusb.c ****     case TUSB_XFER_ISOCHRONOUS: {
 247:libs/tinyusb/tusb.c ****       const uint16_t spec_size = (speed == TUSB_SPEED_HIGH ? 1024 : 1023);
 248:libs/tinyusb/tusb.c ****       TU_ASSERT(max_packet_size <= spec_size);
 249:libs/tinyusb/tusb.c ****       break;
 250:libs/tinyusb/tusb.c ****     }
 251:libs/tinyusb/tusb.c **** 
 252:libs/tinyusb/tusb.c ****     case TUSB_XFER_BULK:
 253:libs/tinyusb/tusb.c ****       if (speed == TUSB_SPEED_HIGH) {
 254:libs/tinyusb/tusb.c ****         // Bulk highspeed must be EXACTLY 512
 255:libs/tinyusb/tusb.c ****         TU_ASSERT(max_packet_size == 512);
 256:libs/tinyusb/tusb.c ****       } else {
 257:libs/tinyusb/tusb.c ****         // Bulk fullspeed can only be 8, 16, 32, 64
 258:libs/tinyusb/tusb.c ****         TU_ASSERT(max_packet_size == 8 || max_packet_size == 16 || max_packet_size == 32 || max_pac
ARM GAS  /tmp//cck2K2Hm.s 			page 6


 259:libs/tinyusb/tusb.c ****       }
 260:libs/tinyusb/tusb.c ****       break;
 261:libs/tinyusb/tusb.c **** 
 262:libs/tinyusb/tusb.c ****     case TUSB_XFER_INTERRUPT: {
 263:libs/tinyusb/tusb.c ****       const uint16_t spec_size = (speed == TUSB_SPEED_HIGH ? 1024 : 64);
 264:libs/tinyusb/tusb.c ****       TU_ASSERT(max_packet_size <= spec_size);
 265:libs/tinyusb/tusb.c ****       break;
 266:libs/tinyusb/tusb.c ****     }
 267:libs/tinyusb/tusb.c **** 
 268:libs/tinyusb/tusb.c ****     default:
 269:libs/tinyusb/tusb.c ****       return false;
 270:libs/tinyusb/tusb.c ****   }
 271:libs/tinyusb/tusb.c **** 
 272:libs/tinyusb/tusb.c ****   return true;
 273:libs/tinyusb/tusb.c **** }
 274:libs/tinyusb/tusb.c **** #endif
 275:libs/tinyusb/tusb.c **** 
 276:libs/tinyusb/tusb.c **** bool tu_bind_driver_to_ep_itf(uint8_t driver_id, uint8_t ep2drv[][2], uint8_t itf2drv[], uint8_t it
 277:libs/tinyusb/tusb.c ****                               const uint8_t *p_desc, uint16_t desc_len) {
 278:libs/tinyusb/tusb.c ****   const uint8_t *desc_end = p_desc + desc_len;
 279:libs/tinyusb/tusb.c ****   while (tu_desc_in_bounds(p_desc, desc_end)) {
 280:libs/tinyusb/tusb.c ****     const uint8_t desc_type = tu_desc_type(p_desc);
 281:libs/tinyusb/tusb.c **** 
 282:libs/tinyusb/tusb.c ****     if (desc_type == TUSB_DESC_ENDPOINT) {
 283:libs/tinyusb/tusb.c ****       const uint8_t ep_addr  = ((const tusb_desc_endpoint_t *)p_desc)->bEndpointAddress;
 284:libs/tinyusb/tusb.c ****       const uint8_t ep_num   = tu_edpt_number(ep_addr);
 285:libs/tinyusb/tusb.c ****       const uint8_t ep_dir   = tu_edpt_dir(ep_addr);
 286:libs/tinyusb/tusb.c ****       ep2drv[ep_num][ep_dir] = driver_id;
 287:libs/tinyusb/tusb.c ****     } else if (desc_type == TUSB_DESC_INTERFACE) {
 288:libs/tinyusb/tusb.c ****       const tusb_desc_interface_t *desc_itf = (const tusb_desc_interface_t *)p_desc;
 289:libs/tinyusb/tusb.c ****       if (desc_itf->bAlternateSetting == 0) {
 290:libs/tinyusb/tusb.c ****         TU_ASSERT(desc_itf->bInterfaceNumber < itf_max);
 291:libs/tinyusb/tusb.c ****         itf2drv[desc_itf->bInterfaceNumber] = driver_id;
 292:libs/tinyusb/tusb.c ****       }
 293:libs/tinyusb/tusb.c ****     }
 294:libs/tinyusb/tusb.c **** 
 295:libs/tinyusb/tusb.c ****     p_desc = tu_desc_next(p_desc);
 296:libs/tinyusb/tusb.c ****   }
 297:libs/tinyusb/tusb.c ****   return true;
 298:libs/tinyusb/tusb.c **** }
