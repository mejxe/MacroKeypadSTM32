 147:libs/tinyusb/tusb.c **** bool tusb_deinit(uint8_t rhport) {
 148:libs/tinyusb/tusb.c ****   TU_VERIFY(rhport < TUP_USBIP_CONTROLLER_NUM);
 149:libs/tinyusb/tusb.c ****   bool ret = false;
 150:libs/tinyusb/tusb.c **** 
 151:libs/tinyusb/tusb.c ****   #if CFG_TUD_ENABLED
 152:libs/tinyusb/tusb.c ****   if (_tusb_rhport_role[rhport] == TUSB_ROLE_DEVICE) {
 153:libs/tinyusb/tusb.c ****     TU_ASSERT(tud_deinit(rhport));
 154:libs/tinyusb/tusb.c ****     _tusb_rhport_role[rhport] = TUSB_ROLE_INVALID;
 155:libs/tinyusb/tusb.c ****     ret = true;
 156:libs/tinyusb/tusb.c ****   }
 157:libs/tinyusb/tusb.c ****   #endif
 158:libs/tinyusb/tusb.c **** 
 159:libs/tinyusb/tusb.c ****   #if CFG_TUH_ENABLED
 160:libs/tinyusb/tusb.c ****   if (_tusb_rhport_role[rhport] == TUSB_ROLE_HOST) {
 161:libs/tinyusb/tusb.c ****     TU_ASSERT(tuh_deinit(rhport));
 162:libs/tinyusb/tusb.c ****     _tusb_rhport_role[rhport] = TUSB_ROLE_INVALID;
 163:libs/tinyusb/tusb.c ****     ret = true;
 164:libs/tinyusb/tusb.c ****   }
 165:libs/tinyusb/tusb.c ****   #endif
 166:libs/tinyusb/tusb.c **** 
 167:libs/tinyusb/tusb.c ****   return ret;
 168:libs/tinyusb/tusb.c **** }
