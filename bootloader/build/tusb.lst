 133:libs/tinyusb/tusb.c ****   #if CFG_TUD_ENABLED
 134:libs/tinyusb/tusb.c ****   if (_tusb_rhport_role[rhport] == TUSB_ROLE_DEVICE) {
 135:libs/tinyusb/tusb.c ****     (void) in_isr;
 136:libs/tinyusb/tusb.c ****     dcd_int_handler(rhport);
 137:libs/tinyusb/tusb.c ****   }
 138:libs/tinyusb/tusb.c ****   #endif
 139:libs/tinyusb/tusb.c **** 
 140:libs/tinyusb/tusb.c ****   #if CFG_TUH_ENABLED
 141:libs/tinyusb/tusb.c ****   if (_tusb_rhport_role[rhport] == TUSB_ROLE_HOST) {
 142:libs/tinyusb/tusb.c ****     hcd_int_handler(rhport, in_isr);
 143:libs/tinyusb/tusb.c ****   }
 144:libs/tinyusb/tusb.c ****   #endif
