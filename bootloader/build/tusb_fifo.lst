   9:libs/tinyusb/common/tusb_fifo.c **** #include "osal/osal.h"
  10:libs/tinyusb/common/tusb_fifo.c **** #include "tusb_fifo.h"
  11:libs/tinyusb/common/tusb_fifo.c **** 
  12:libs/tinyusb/common/tusb_fifo.c **** #define TU_FIFO_DBG 0
  13:libs/tinyusb/common/tusb_fifo.c **** 
  14:libs/tinyusb/common/tusb_fifo.c **** 
  15:libs/tinyusb/common/tusb_fifo.c **** #if OSAL_MUTEX_REQUIRED
  16:libs/tinyusb/common/tusb_fifo.c **** 
  17:libs/tinyusb/common/tusb_fifo.c **** TU_ATTR_ALWAYS_INLINE static inline void ff_lock(osal_mutex_t mutex) {
  18:libs/tinyusb/common/tusb_fifo.c ****   if (mutex != NULL) {
  19:libs/tinyusb/common/tusb_fifo.c ****     osal_mutex_lock(mutex, OSAL_TIMEOUT_WAIT_FOREVER);
  20:libs/tinyusb/common/tusb_fifo.c ****   }
  21:libs/tinyusb/common/tusb_fifo.c **** }
  22:libs/tinyusb/common/tusb_fifo.c **** 
  23:libs/tinyusb/common/tusb_fifo.c **** TU_ATTR_ALWAYS_INLINE static inline void ff_unlock(osal_mutex_t mutex) {
  24:libs/tinyusb/common/tusb_fifo.c ****   if (mutex != NULL) {
  25:libs/tinyusb/common/tusb_fifo.c ****     osal_mutex_unlock(mutex);
  26:libs/tinyusb/common/tusb_fifo.c ****   }
  27:libs/tinyusb/common/tusb_fifo.c **** }
  28:libs/tinyusb/common/tusb_fifo.c **** 
  29:libs/tinyusb/common/tusb_fifo.c **** #else
  30:libs/tinyusb/common/tusb_fifo.c ****   #define ff_lock(_mutex)
ARM GAS  /tmp//ccOZCI5H.s 			page 2


  31:libs/tinyusb/common/tusb_fifo.c ****   #define ff_unlock(_mutex)
  32:libs/tinyusb/common/tusb_fifo.c **** 
