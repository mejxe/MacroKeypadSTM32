 554:libs/tinyusb/common/tusb_fifo.c ****       }
 555:libs/tinyusb/common/tusb_fifo.c ****     }
 556:libs/tinyusb/common/tusb_fifo.c ****   }
 557:libs/tinyusb/common/tusb_fifo.c **** 
 558:libs/tinyusb/common/tusb_fifo.c ****   if (n) {
 559:libs/tinyusb/common/tusb_fifo.c ****     const uint16_t wr_ptr = idx2ptr(f->depth, wr_idx);
 560:libs/tinyusb/common/tusb_fifo.c ****     TU_LOG(TU_FIFO_DBG, "actual_n = %u, wr_ptr = %u", n, wr_ptr);
 561:libs/tinyusb/common/tusb_fifo.c **** 
 562:libs/tinyusb/common/tusb_fifo.c **** #if CFG_TUSB_FIFO_HWFIFO_API
 563:libs/tinyusb/common/tusb_fifo.c ****     if (access_mode != NULL) {
 564:libs/tinyusb/common/tusb_fifo.c ****       hwff_push_n(f, buf8, n, wr_ptr, access_mode);
 565:libs/tinyusb/common/tusb_fifo.c ****     } else
 566:libs/tinyusb/common/tusb_fifo.c **** #endif
 567:libs/tinyusb/common/tusb_fifo.c ****     {
 568:libs/tinyusb/common/tusb_fifo.c ****       ff_push_n(f, buf8, n, wr_ptr);
 569:libs/tinyusb/common/tusb_fifo.c ****     }
 570:libs/tinyusb/common/tusb_fifo.c ****     f->wr_idx = advance_index(f->depth, wr_idx, n);
 571:libs/tinyusb/common/tusb_fifo.c **** 
 572:libs/tinyusb/common/tusb_fifo.c ****     TU_LOG(TU_FIFO_DBG, "\tnew_wr = %u\r\n", f->wr_idx);
 573:libs/tinyusb/common/tusb_fifo.c ****   }
 574:libs/tinyusb/common/tusb_fifo.c **** 
 575:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
 576:libs/tinyusb/common/tusb_fifo.c **** 
 577:libs/tinyusb/common/tusb_fifo.c ****   return n;
 578:libs/tinyusb/common/tusb_fifo.c **** }
 579:libs/tinyusb/common/tusb_fifo.c **** 
 580:libs/tinyusb/common/tusb_fifo.c **** uint16_t tu_fifo_discard_n(tu_fifo_t *f, uint16_t n) {
 581:libs/tinyusb/common/tusb_fifo.c ****   const uint16_t count = tu_min16(n, tu_fifo_count(f)); // limit to available count
 582:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
 583:libs/tinyusb/common/tusb_fifo.c ****   f->rd_idx = advance_index(f->depth, f->rd_idx, count);
 584:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
 585:libs/tinyusb/common/tusb_fifo.c **** 
 586:libs/tinyusb/common/tusb_fifo.c ****   return count;
 587:libs/tinyusb/common/tusb_fifo.c **** }
