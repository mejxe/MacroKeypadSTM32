 359:libs/tinyusb/common/tusb_fifo.c **** // Pull & Push
 360:libs/tinyusb/common/tusb_fifo.c **** // copy data to/from fifo without updating read/write pointers
 361:libs/tinyusb/common/tusb_fifo.c **** //--------------------------------------------------------------------+
 362:libs/tinyusb/common/tusb_fifo.c **** // send n items to fifo WITHOUT updating write pointer
 363:libs/tinyusb/common/tusb_fifo.c **** static void ff_push_n(const tu_fifo_t *f, const void *app_buf, uint16_t n, uint16_t wr_ptr) {
 364:libs/tinyusb/common/tusb_fifo.c ****   uint16_t lin_bytes  = f->depth - wr_ptr;
 365:libs/tinyusb/common/tusb_fifo.c ****   uint16_t wrap_bytes = n - lin_bytes;
 366:libs/tinyusb/common/tusb_fifo.c ****   uint8_t *ff_buf     = f->buffer + wr_ptr;
 367:libs/tinyusb/common/tusb_fifo.c **** 
 368:libs/tinyusb/common/tusb_fifo.c ****   if (n <= lin_bytes) {
 369:libs/tinyusb/common/tusb_fifo.c ****     // Linear only case
 370:libs/tinyusb/common/tusb_fifo.c ****     memcpy(ff_buf, app_buf, n);
 371:libs/tinyusb/common/tusb_fifo.c ****   } else {
 372:libs/tinyusb/common/tusb_fifo.c ****     // Wrap around case
ARM GAS  /tmp//ccOZCI5H.s 			page 8


 373:libs/tinyusb/common/tusb_fifo.c ****     memcpy(ff_buf, app_buf, lin_bytes);                                    // linear part
 374:libs/tinyusb/common/tusb_fifo.c ****     memcpy(f->buffer, ((const uint8_t *)app_buf) + lin_bytes, wrap_bytes); // wrapped part
 375:libs/tinyusb/common/tusb_fifo.c ****   }
 376:libs/tinyusb/common/tusb_fifo.c **** }
 377:libs/tinyusb/common/tusb_fifo.c **** 
 378:libs/tinyusb/common/tusb_fifo.c **** // get n items from fifo WITHOUT updating read pointer
 379:libs/tinyusb/common/tusb_fifo.c **** static void ff_pull_n(const tu_fifo_t *f, void *app_buf, uint16_t n, uint16_t rd_ptr) {
 380:libs/tinyusb/common/tusb_fifo.c ****   uint16_t       lin_bytes  = f->depth - rd_ptr;
 381:libs/tinyusb/common/tusb_fifo.c ****   uint16_t       wrap_bytes = n - lin_bytes; // only used if wrapped
 382:libs/tinyusb/common/tusb_fifo.c ****   const uint8_t *ff_buf     = f->buffer + rd_ptr;
 383:libs/tinyusb/common/tusb_fifo.c **** 
 384:libs/tinyusb/common/tusb_fifo.c ****   // single byte access
 385:libs/tinyusb/common/tusb_fifo.c ****   if (n <= lin_bytes) {
 386:libs/tinyusb/common/tusb_fifo.c ****     // Linear only
 387:libs/tinyusb/common/tusb_fifo.c ****     memcpy(app_buf, ff_buf, n);
 388:libs/tinyusb/common/tusb_fifo.c ****   } else {
 389:libs/tinyusb/common/tusb_fifo.c ****     // Wrap around
 390:libs/tinyusb/common/tusb_fifo.c ****     memcpy(app_buf, ff_buf, lin_bytes);                            // linear part
 391:libs/tinyusb/common/tusb_fifo.c ****     memcpy((uint8_t *)app_buf + lin_bytes, f->buffer, wrap_bytes); // wrapped part
 392:libs/tinyusb/common/tusb_fifo.c ****   }
 393:libs/tinyusb/common/tusb_fifo.c **** }
