  22:libs/tinyusb/common/tusb_fifo.h **** // mutex is only needed for RTOS. For OS None, we don't get preempted
  23:libs/tinyusb/common/tusb_fifo.h **** #define CFG_FIFO_MUTEX      OSAL_MUTEX_REQUIRED
  24:libs/tinyusb/common/tusb_fifo.h **** 
