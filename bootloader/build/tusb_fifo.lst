 689:libs/tinyusb/common/tusb_fifo.c **** /*!
 690:libs/tinyusb/common/tusb_fifo.c ****     @brief Advance read pointer - intended to be used in combination with DMA.
 691:libs/tinyusb/common/tusb_fifo.c ****     It is possible to read from the FIFO by use of a DMA in linear mode. Within
 692:libs/tinyusb/common/tusb_fifo.c ****     DMA ISRs you may update the read pointer to be able to again write into the
 693:libs/tinyusb/common/tusb_fifo.c ****     FIFO. As long as the DMA is the only process reading from the FIFO this is
 694:libs/tinyusb/common/tusb_fifo.c ****     safe to use.
 695:libs/tinyusb/common/tusb_fifo.c **** 
 696:libs/tinyusb/common/tusb_fifo.c ****     USE WITH CARE - WE DO NOT CONDUCT SAFETY CHECKS HERE!
 697:libs/tinyusb/common/tusb_fifo.c **** 
 698:libs/tinyusb/common/tusb_fifo.c ****     @param[in]  f
 699:libs/tinyusb/common/tusb_fifo.c ****                 Pointer to the FIFO buffer to manipulate
 700:libs/tinyusb/common/tusb_fifo.c ****     @param[in]  n
 701:libs/tinyusb/common/tusb_fifo.c ****                 Number of items the read pointer moves forward
 702:libs/tinyusb/common/tusb_fifo.c ****  */
