  34:libs/tinyusb/common/tusb_fifo.c **** 
  35:libs/tinyusb/common/tusb_fifo.c **** //--------------------------------------------------------------------+
  36:libs/tinyusb/common/tusb_fifo.c **** // Setup API
  37:libs/tinyusb/common/tusb_fifo.c **** //--------------------------------------------------------------------+
  38:libs/tinyusb/common/tusb_fifo.c **** bool tu_fifo_config(tu_fifo_t *f, void *buffer, uint16_t depth, bool overwritable) {
  39:libs/tinyusb/common/tusb_fifo.c ****   // Limit index space to 2*depth - this allows for a fast "modulo" calculation
  40:libs/tinyusb/common/tusb_fifo.c ****   // but limits the maximum depth to 2^16/2 = 2^15 and buffer overflows are detectable
  41:libs/tinyusb/common/tusb_fifo.c ****   // only if overflow happens once (important for unsupervised DMA applications)
  42:libs/tinyusb/common/tusb_fifo.c ****   if (depth > 0x8000) {
  43:libs/tinyusb/common/tusb_fifo.c ****     return false;
  44:libs/tinyusb/common/tusb_fifo.c ****   }
  45:libs/tinyusb/common/tusb_fifo.c **** 
  46:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
  47:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
  48:libs/tinyusb/common/tusb_fifo.c **** 
  49:libs/tinyusb/common/tusb_fifo.c ****   f->buffer       = (uint8_t *)buffer;
  50:libs/tinyusb/common/tusb_fifo.c ****   f->depth        = depth;
  51:libs/tinyusb/common/tusb_fifo.c ****   f->overwritable = overwritable;
  52:libs/tinyusb/common/tusb_fifo.c ****   f->rd_idx       = 0u;
  53:libs/tinyusb/common/tusb_fifo.c ****   f->wr_idx       = 0u;
  54:libs/tinyusb/common/tusb_fifo.c **** 
  55:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
  56:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
  57:libs/tinyusb/common/tusb_fifo.c **** 
  58:libs/tinyusb/common/tusb_fifo.c ****   return true;
  59:libs/tinyusb/common/tusb_fifo.c **** }
  60:libs/tinyusb/common/tusb_fifo.c **** 
  61:libs/tinyusb/common/tusb_fifo.c **** // clear fifo by resetting read and write indices
  62:libs/tinyusb/common/tusb_fifo.c **** void tu_fifo_clear(tu_fifo_t *f) {
  63:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
  64:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
  65:libs/tinyusb/common/tusb_fifo.c **** 
  66:libs/tinyusb/common/tusb_fifo.c ****   f->rd_idx = 0;
  67:libs/tinyusb/common/tusb_fifo.c ****   f->wr_idx = 0;
  68:libs/tinyusb/common/tusb_fifo.c **** 
  69:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
  70:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
  71:libs/tinyusb/common/tusb_fifo.c **** }
  72:libs/tinyusb/common/tusb_fifo.c **** 
  73:libs/tinyusb/common/tusb_fifo.c **** // Change the fifo overwritable mode
  74:libs/tinyusb/common/tusb_fifo.c **** void tu_fifo_set_overwritable(tu_fifo_t *f, bool overwritable) {
  75:libs/tinyusb/common/tusb_fifo.c ****   if (f->overwritable == overwritable) {
  76:libs/tinyusb/common/tusb_fifo.c ****     return;
  77:libs/tinyusb/common/tusb_fifo.c ****   }
  78:libs/tinyusb/common/tusb_fifo.c **** 
  79:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
  80:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
  81:libs/tinyusb/common/tusb_fifo.c **** 
  82:libs/tinyusb/common/tusb_fifo.c ****   f->overwritable = overwritable;
  83:libs/tinyusb/common/tusb_fifo.c **** 
  84:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
  85:libs/tinyusb/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
  86:libs/tinyusb/common/tusb_fifo.c **** }
  87:libs/tinyusb/common/tusb_fifo.c **** 
