 498:libs/tinyusb/common/tusb_fifo.c **** // Write n items to fifo with access mode
 499:libs/tinyusb/common/tusb_fifo.c **** uint16_t tu_fifo_write_n_access_mode(tu_fifo_t *f, const void *data, uint16_t n,
 500:libs/tinyusb/common/tusb_fifo.c ****                                      const tu_hwfifo_access_t *access_mode) {
 501:libs/tinyusb/common/tusb_fifo.c ****   if (n == 0) {
 502:libs/tinyusb/common/tusb_fifo.c ****     return 0;
 503:libs/tinyusb/common/tusb_fifo.c ****   }
 504:libs/tinyusb/common/tusb_fifo.c **** 
 505:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
 506:libs/tinyusb/common/tusb_fifo.c **** 
 507:libs/tinyusb/common/tusb_fifo.c ****   uint16_t wr_idx = f->wr_idx;
 508:libs/tinyusb/common/tusb_fifo.c ****   uint16_t rd_idx = f->rd_idx;
 509:libs/tinyusb/common/tusb_fifo.c **** 
 510:libs/tinyusb/common/tusb_fifo.c ****   const uint8_t *buf8 = (const uint8_t *)data;
 511:libs/tinyusb/common/tusb_fifo.c **** 
 512:libs/tinyusb/common/tusb_fifo.c ****   TU_LOG(TU_FIFO_DBG, "rd = %3u, wr = %3u, count = %3u, remain = %3u, n = %3u:  ", rd_idx, wr_idx,
 513:libs/tinyusb/common/tusb_fifo.c ****          tu_ff_overflow_count(f->depth, wr_idx, rd_idx), tu_ff_remaining_local(f->depth, wr_idx, rd
 514:libs/tinyusb/common/tusb_fifo.c **** 
 515:libs/tinyusb/common/tusb_fifo.c ****   if (!f->overwritable) {
 516:libs/tinyusb/common/tusb_fifo.c ****     // limit up to full
 517:libs/tinyusb/common/tusb_fifo.c ****     const uint16_t remain = tu_ff_remaining_local(f->depth, wr_idx, rd_idx);
 518:libs/tinyusb/common/tusb_fifo.c ****     n                     = tu_min16(n, remain);
 519:libs/tinyusb/common/tusb_fifo.c ****   } else {
 520:libs/tinyusb/common/tusb_fifo.c ****     // In over-writable mode, fifo_write() is allowed even when fifo is full. In such case,
 521:libs/tinyusb/common/tusb_fifo.c ****     // oldest data in fifo i.e. at read pointer data will be overwritten
 522:libs/tinyusb/common/tusb_fifo.c ****     // Note: we can modify read buffer contents however we must not modify the read index itself wi
 523:libs/tinyusb/common/tusb_fifo.c ****     // function! Since it would end up in a race condition with read functions!
 524:libs/tinyusb/common/tusb_fifo.c ****     if (n >= f->depth) {
 525:libs/tinyusb/common/tusb_fifo.c ****       // Only copy last part
 526:libs/tinyusb/common/tusb_fifo.c ****       if (access_mode == NULL) {
