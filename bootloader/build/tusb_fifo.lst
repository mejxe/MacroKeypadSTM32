 549:libs/tinyusb/common/tusb_fifo.c ****       } else {
 550:libs/tinyusb/common/tusb_fifo.c ****         // normal + single overflowed:
 551:libs/tinyusb/common/tusb_fifo.c ****         // Index is in the range of [0,2*depth) and thus detect and recoverable. Recovering is hand
