 441:libs/tinyusb/common/tusb_fifo.c **** // Works on local copies of w and r
 442:libs/tinyusb/common/tusb_fifo.c **** // Must be protected by read mutex since in case of an overflow read pointer gets modified
 443:libs/tinyusb/common/tusb_fifo.c **** uint16_t tu_fifo_peek_n_access_mode(tu_fifo_t *f, void *p_buffer, uint16_t n, uint16_t wr_idx, uint
