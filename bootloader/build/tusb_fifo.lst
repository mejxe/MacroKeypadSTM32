  88:libs/tinyusb/common/tusb_fifo.c **** //--------------------------------------------------------------------+
  89:libs/tinyusb/common/tusb_fifo.c **** // Hardware FIFO API
  90:libs/tinyusb/common/tusb_fifo.c **** // Support different data access width and address increment scheme
  91:libs/tinyusb/common/tusb_fifo.c **** // Can support multiple i.e both 16 and 32-bit data access if needed
  92:libs/tinyusb/common/tusb_fifo.c **** //--------------------------------------------------------------------+
  93:libs/tinyusb/common/tusb_fifo.c **** #if CFG_TUSB_FIFO_HWFIFO_API
  94:libs/tinyusb/common/tusb_fifo.c ****   #if CFG_TUSB_FIFO_HWFIFO_ADDR_STRIDE > 0
  95:libs/tinyusb/common/tusb_fifo.c ****     #define HWFIFO_ADDR_NEXT_N(_hwfifo, _const, _n) _hwfifo = (_const volatile void *)((uintptr_t)(
  96:libs/tinyusb/common/tusb_fifo.c ****   #else
  97:libs/tinyusb/common/tusb_fifo.c ****     #define HWFIFO_ADDR_NEXT_N(_hwfifo, _const, _n)
  98:libs/tinyusb/common/tusb_fifo.c ****   #endif
  99:libs/tinyusb/common/tusb_fifo.c **** 
 100:libs/tinyusb/common/tusb_fifo.c ****   #define HWFIFO_ADDR_NEXT(_hwfifo, _const) HWFIFO_ADDR_NEXT_N(_hwfifo, _const, CFG_TUSB_FIFO_HWFIF
 101:libs/tinyusb/common/tusb_fifo.c **** 
 102:libs/tinyusb/common/tusb_fifo.c ****   // the fixed ratio works since in the only case of dynamic/multiple data_stride (rusb2): addr_str
 103:libs/tinyusb/common/tusb_fifo.c ****   #define HWFIFO_ADDR_DATA_RATIO (CFG_TUSB_FIFO_HWFIFO_ADDR_STRIDE / CFG_TUSB_FIFO_HWFIFO_DATA_STRI
 104:libs/tinyusb/common/tusb_fifo.c **** 
 105:libs/tinyusb/common/tusb_fifo.c **** //------------- Write -------------//
 106:libs/tinyusb/common/tusb_fifo.c ****   #ifndef CFG_TUSB_FIFO_HWFIFO_CUSTOM_WRITE
 107:libs/tinyusb/common/tusb_fifo.c **** TU_ATTR_ALWAYS_INLINE static inline void stride_write(volatile void *hwfifo, const void *src, uint8
 108:libs/tinyusb/common/tusb_fifo.c ****   (void)data_stride; // possible unused
 109:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE & 4
 110:libs/tinyusb/common/tusb_fifo.c ****       #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE != 4
 111:libs/tinyusb/common/tusb_fifo.c ****   if (data_stride == 4)
 112:libs/tinyusb/common/tusb_fifo.c ****       #endif
 113:libs/tinyusb/common/tusb_fifo.c ****   {
 114:libs/tinyusb/common/tusb_fifo.c ****     *((volatile uint32_t *)hwfifo) = tu_unaligned_read32(src);
 115:libs/tinyusb/common/tusb_fifo.c ****   }
 116:libs/tinyusb/common/tusb_fifo.c ****     #endif
 117:libs/tinyusb/common/tusb_fifo.c **** 
 118:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE & 2
 119:libs/tinyusb/common/tusb_fifo.c ****       #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE != 2
 120:libs/tinyusb/common/tusb_fifo.c ****   if (data_stride == 2)
 121:libs/tinyusb/common/tusb_fifo.c ****       #endif
 122:libs/tinyusb/common/tusb_fifo.c ****   {
 123:libs/tinyusb/common/tusb_fifo.c ****     *((volatile uint16_t *)hwfifo) = tu_unaligned_read16(src);
 124:libs/tinyusb/common/tusb_fifo.c ****   }
 125:libs/tinyusb/common/tusb_fifo.c ****     #endif
 126:libs/tinyusb/common/tusb_fifo.c **** 
 127:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE == 1
 128:libs/tinyusb/common/tusb_fifo.c ****   *((volatile uint8_t *)hwfifo) = *(const uint8_t *)src;
 129:libs/tinyusb/common/tusb_fifo.c ****     #endif
 130:libs/tinyusb/common/tusb_fifo.c **** }
 131:libs/tinyusb/common/tusb_fifo.c **** 
 132:libs/tinyusb/common/tusb_fifo.c **** // Copy from fifo to fixed address buffer (usually a tx register) with TU_FIFO_FIXED_ADDR_RW32 mode
 133:libs/tinyusb/common/tusb_fifo.c **** void tu_hwfifo_write(volatile void *hwfifo, const uint8_t *src, uint16_t len, const tu_hwfifo_acces
 134:libs/tinyusb/common/tusb_fifo.c ****   // Write full available 16/32 bit words to dest
 135:libs/tinyusb/common/tusb_fifo.c ****   const uint8_t data_stride = (access_mode != NULL) ? access_mode->data_stride : CFG_TUSB_FIFO_HWFI
 136:libs/tinyusb/common/tusb_fifo.c ****   while (len >= data_stride) {
 137:libs/tinyusb/common/tusb_fifo.c ****     stride_write(hwfifo, src, data_stride);
 138:libs/tinyusb/common/tusb_fifo.c ****     src += data_stride;
 139:libs/tinyusb/common/tusb_fifo.c ****     len -= data_stride;
 140:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT(hwfifo, );
 141:libs/tinyusb/common/tusb_fifo.c ****   }
 142:libs/tinyusb/common/tusb_fifo.c **** 
 143:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE > 1
 144:libs/tinyusb/common/tusb_fifo.c ****       #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_16BIT_ACCESS
ARM GAS  /tmp//ccOZCI5H.s 			page 4


 145:libs/tinyusb/common/tusb_fifo.c ****   // 16-bit access is allowed for odd bytes
 146:libs/tinyusb/common/tusb_fifo.c ****   if (len >= 2) {
 147:libs/tinyusb/common/tusb_fifo.c ****     *((volatile uint16_t *)hwfifo) = tu_unaligned_read16(src);
 148:libs/tinyusb/common/tusb_fifo.c ****     src += 2;
 149:libs/tinyusb/common/tusb_fifo.c ****     len -= 2;
 150:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, , 2);
 151:libs/tinyusb/common/tusb_fifo.c ****   }
 152:libs/tinyusb/common/tusb_fifo.c ****       #endif
 153:libs/tinyusb/common/tusb_fifo.c **** 
 154:libs/tinyusb/common/tusb_fifo.c ****       #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_8BIT_ACCESS
 155:libs/tinyusb/common/tusb_fifo.c ****   // 8-bit access is allowed for odd bytes
 156:libs/tinyusb/common/tusb_fifo.c ****   while (len > 0) {
 157:libs/tinyusb/common/tusb_fifo.c ****     *((volatile uint8_t *)hwfifo) = *src++;
 158:libs/tinyusb/common/tusb_fifo.c ****     len--;
 159:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, , 1);
 160:libs/tinyusb/common/tusb_fifo.c ****   }
 161:libs/tinyusb/common/tusb_fifo.c ****       #else
 162:libs/tinyusb/common/tusb_fifo.c **** 
 163:libs/tinyusb/common/tusb_fifo.c ****   // Write odd bytes i.e 1 byte for 16 bit or 1-3 bytes for 32 bit
 164:libs/tinyusb/common/tusb_fifo.c ****   if (len > 0) {
 165:libs/tinyusb/common/tusb_fifo.c ****     uint32_t tmp = 0u;
 166:libs/tinyusb/common/tusb_fifo.c ****     memcpy(&tmp, src, len);
 167:libs/tinyusb/common/tusb_fifo.c ****     stride_write(hwfifo, &tmp, data_stride);
 168:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT(hwfifo, );
 169:libs/tinyusb/common/tusb_fifo.c ****   }
 170:libs/tinyusb/common/tusb_fifo.c ****       #endif
 171:libs/tinyusb/common/tusb_fifo.c ****     #endif
 172:libs/tinyusb/common/tusb_fifo.c **** }
 173:libs/tinyusb/common/tusb_fifo.c ****   #endif
 174:libs/tinyusb/common/tusb_fifo.c **** 
 175:libs/tinyusb/common/tusb_fifo.c **** //------------- Read -------------//
 176:libs/tinyusb/common/tusb_fifo.c ****   #ifndef CFG_TUSB_FIFO_HWFIFO_CUSTOM_READ
 177:libs/tinyusb/common/tusb_fifo.c **** TU_ATTR_ALWAYS_INLINE static inline void stride_read(const volatile void *hwfifo, void *dest, uint8
 178:libs/tinyusb/common/tusb_fifo.c ****   (void)data_stride; // possible unused
 179:libs/tinyusb/common/tusb_fifo.c **** 
 180:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE & 4
 181:libs/tinyusb/common/tusb_fifo.c ****       #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE != 4
 182:libs/tinyusb/common/tusb_fifo.c ****   if (data_stride == 4)
 183:libs/tinyusb/common/tusb_fifo.c ****       #endif
 184:libs/tinyusb/common/tusb_fifo.c ****   {
 185:libs/tinyusb/common/tusb_fifo.c ****     tu_unaligned_write32(dest, *((const volatile uint32_t *)hwfifo));
 186:libs/tinyusb/common/tusb_fifo.c ****   }
 187:libs/tinyusb/common/tusb_fifo.c ****     #endif
 188:libs/tinyusb/common/tusb_fifo.c **** 
 189:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE & 2
 190:libs/tinyusb/common/tusb_fifo.c ****       #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE != 2
 191:libs/tinyusb/common/tusb_fifo.c ****   if (data_stride == 2)
 192:libs/tinyusb/common/tusb_fifo.c ****       #endif
 193:libs/tinyusb/common/tusb_fifo.c ****   {
 194:libs/tinyusb/common/tusb_fifo.c ****     tu_unaligned_write16(dest, *((const volatile uint16_t *)hwfifo));
 195:libs/tinyusb/common/tusb_fifo.c ****   }
 196:libs/tinyusb/common/tusb_fifo.c ****     #endif
 197:libs/tinyusb/common/tusb_fifo.c **** 
 198:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE == 1
 199:libs/tinyusb/common/tusb_fifo.c ****   *(uint8_t *)dest = *((const volatile uint8_t *)hwfifo);
 200:libs/tinyusb/common/tusb_fifo.c ****     #endif
 201:libs/tinyusb/common/tusb_fifo.c **** }
