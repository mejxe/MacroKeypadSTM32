 476:libs/tinyusb/common/tusb_fifo.c **** uint16_t tu_fifo_peek_n(tu_fifo_t *f, void *p_buffer, uint16_t n) {
 477:libs/tinyusb/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
