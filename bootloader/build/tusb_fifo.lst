 445:libs/tinyusb/common/tusb_fifo.c ****   uint16_t count = tu_ff_overflow_count(f->depth, wr_idx, rd_idx);
 446:libs/tinyusb/common/tusb_fifo.c ****   if (count == 0) {
 447:libs/tinyusb/common/tusb_fifo.c ****     return 0; // nothing to peek
 448:libs/tinyusb/common/tusb_fifo.c ****   }
 449:libs/tinyusb/common/tusb_fifo.c **** 
 450:libs/tinyusb/common/tusb_fifo.c ****   // Check overflow and correct if required
