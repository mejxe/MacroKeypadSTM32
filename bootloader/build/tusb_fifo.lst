 202:libs/tinyusb/common/tusb_fifo.c **** 
 203:libs/tinyusb/common/tusb_fifo.c **** void tu_hwfifo_read(const volatile void *hwfifo, uint8_t *dest, uint16_t len, const tu_hwfifo_acces
 204:libs/tinyusb/common/tusb_fifo.c ****   // Reading full available 16/32-bit hwfifo and write to fifo
 205:libs/tinyusb/common/tusb_fifo.c ****   const uint8_t data_stride = (access_mode != NULL) ? access_mode->data_stride : CFG_TUSB_FIFO_HWFI
 206:libs/tinyusb/common/tusb_fifo.c ****   while (len >= data_stride) {
 207:libs/tinyusb/common/tusb_fifo.c ****     stride_read(hwfifo, dest, data_stride);
 208:libs/tinyusb/common/tusb_fifo.c ****     dest += data_stride;
 209:libs/tinyusb/common/tusb_fifo.c ****     len -= data_stride;
 210:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT(hwfifo, const);
 211:libs/tinyusb/common/tusb_fifo.c ****   }
 212:libs/tinyusb/common/tusb_fifo.c **** 
 213:libs/tinyusb/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE > 1
 214:libs/tinyusb/common/tusb_fifo.c ****       #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_16BIT_ACCESS
 215:libs/tinyusb/common/tusb_fifo.c ****   // 16-bit access is allowed for odd bytes
 216:libs/tinyusb/common/tusb_fifo.c ****   if (len >= 2) {
 217:libs/tinyusb/common/tusb_fifo.c ****     tu_unaligned_write16(dest, *((const volatile uint16_t *)hwfifo));
 218:libs/tinyusb/common/tusb_fifo.c ****     dest += 2;
 219:libs/tinyusb/common/tusb_fifo.c ****     len -= 2;
 220:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, const, 2);
 221:libs/tinyusb/common/tusb_fifo.c ****   }
 222:libs/tinyusb/common/tusb_fifo.c ****       #endif
 223:libs/tinyusb/common/tusb_fifo.c **** 
 224:libs/tinyusb/common/tusb_fifo.c ****       #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_8BIT_ACCESS
 225:libs/tinyusb/common/tusb_fifo.c ****   // 8-bit access is allowed for odd bytes
 226:libs/tinyusb/common/tusb_fifo.c ****   while (len > 0) {
 227:libs/tinyusb/common/tusb_fifo.c ****     *dest++ = *((const volatile uint8_t *)hwfifo);
 228:libs/tinyusb/common/tusb_fifo.c ****     len--;
 229:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, const, 1);
 230:libs/tinyusb/common/tusb_fifo.c ****   }
 231:libs/tinyusb/common/tusb_fifo.c ****       #else
 232:libs/tinyusb/common/tusb_fifo.c ****   // Read odd bytes i.e 1 byte for 16 bit or 1-3 bytes for 32 bit
 233:libs/tinyusb/common/tusb_fifo.c ****   if (len > 0) {
 234:libs/tinyusb/common/tusb_fifo.c ****     uint32_t tmp;
 235:libs/tinyusb/common/tusb_fifo.c ****     stride_read(hwfifo, &tmp, data_stride);
 236:libs/tinyusb/common/tusb_fifo.c ****     memcpy(dest, &tmp, len);
 237:libs/tinyusb/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT(hwfifo, const);
 238:libs/tinyusb/common/tusb_fifo.c ****   }
 239:libs/tinyusb/common/tusb_fifo.c ****       #endif
 240:libs/tinyusb/common/tusb_fifo.c ****     #endif
 241:libs/tinyusb/common/tusb_fifo.c **** }
 242:libs/tinyusb/common/tusb_fifo.c ****   #endif
 243:libs/tinyusb/common/tusb_fifo.c **** 
 244:libs/tinyusb/common/tusb_fifo.c **** // push to sw fifo from hwfifo
 245:libs/tinyusb/common/tusb_fifo.c **** static void hwff_push_n(const tu_fifo_t *f, const void *app_buf, uint16_t n, uint16_t wr_ptr,
 246:libs/tinyusb/common/tusb_fifo.c ****                         const tu_hwfifo_access_t *access_mode) {
 247:libs/tinyusb/common/tusb_fifo.c ****   uint16_t lin_bytes  = f->depth - wr_ptr;
 248:libs/tinyusb/common/tusb_fifo.c ****   uint16_t wrap_bytes = n - lin_bytes;
 249:libs/tinyusb/common/tusb_fifo.c ****   uint8_t *ff_buf     = f->buffer + wr_ptr;
 250:libs/tinyusb/common/tusb_fifo.c **** 
 251:libs/tinyusb/common/tusb_fifo.c ****   const volatile void *hwfifo = (const volatile void *)app_buf;
 252:libs/tinyusb/common/tusb_fifo.c ****   if (n <= lin_bytes) {
 253:libs/tinyusb/common/tusb_fifo.c ****     // Linear only case
 254:libs/tinyusb/common/tusb_fifo.c ****     tu_hwfifo_read(hwfifo, ff_buf, n, access_mode);
 255:libs/tinyusb/common/tusb_fifo.c ****   } else {
 256:libs/tinyusb/common/tusb_fifo.c ****     // Wrap around case
 257:libs/tinyusb/common/tusb_fifo.c ****   #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE == 1
 258:libs/tinyusb/common/tusb_fifo.c ****     tu_hwfifo_read(hwfifo, ff_buf, lin_bytes, access_mode);     // linear part
