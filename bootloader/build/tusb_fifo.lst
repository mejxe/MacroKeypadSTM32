 530:libs/tinyusb/common/tusb_fifo.c ****         // accidentally discard data.
 531:libs/tinyusb/common/tusb_fifo.c ****       }
 532:libs/tinyusb/common/tusb_fifo.c **** 
 533:libs/tinyusb/common/tusb_fifo.c ****       n = f->depth;
 534:libs/tinyusb/common/tusb_fifo.c **** 
 535:libs/tinyusb/common/tusb_fifo.c ****       // We start writing at the read pointer's position since we fill the whole buffer
 536:libs/tinyusb/common/tusb_fifo.c ****       wr_idx = rd_idx;
 537:libs/tinyusb/common/tusb_fifo.c ****     } else {
 538:libs/tinyusb/common/tusb_fifo.c ****       const uint16_t overflowable_count = tu_ff_overflow_count(f->depth, wr_idx, rd_idx);
 539:libs/tinyusb/common/tusb_fifo.c ****       if (overflowable_count + n >= 2 * f->depth) {
