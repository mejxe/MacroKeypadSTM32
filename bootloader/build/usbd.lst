1262:libs/tinyusb/device/usbd.c ****     // Class will always start with Interface Association (if any) and then Interface descriptor
1263:libs/tinyusb/device/usbd.c ****     if (TUSB_DESC_INTERFACE_ASSOCIATION == tu_desc_type(p_desc)) {
1264:libs/tinyusb/device/usbd.c ****       p_desc = tu_desc_next(p_desc); // next to Interface
