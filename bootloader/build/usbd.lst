  33:libs/tinyusb/common/tusb_fifo.h **** #endif
  34:libs/tinyusb/common/tusb_fifo.h **** 
  35:libs/tinyusb/common/tusb_fifo.h **** // Due to the use of unmasked pointers, this FIFO does not suffer from losing
  36:libs/tinyusb/common/tusb_fifo.h **** // one item slice. Furthermore, write and read operations are completely
  37:libs/tinyusb/common/tusb_fifo.h **** // decoupled as write and read functions do not modify a common state. Henceforth,
  38:libs/tinyusb/common/tusb_fifo.h **** // writing or reading from the FIFO within an ISR is safe as long as no other
  39:libs/tinyusb/common/tusb_fifo.h **** // process (thread or ISR) interferes.
  40:libs/tinyusb/common/tusb_fifo.h **** // Also, this FIFO is ready to be used in combination with a DMA as the write and
  41:libs/tinyusb/common/tusb_fifo.h **** // read pointers can be updated from within a DMA ISR. Overflows are detectable
  42:libs/tinyusb/common/tusb_fifo.h **** // within a certain number (see tu_fifo_overflow()).
  43:libs/tinyusb/common/tusb_fifo.h **** 
  44:libs/tinyusb/common/tusb_fifo.h **** /* Write/Read "pointer" is in the range of: 0 .. depth - 1, and is used to get the fifo data.
  45:libs/tinyusb/common/tusb_fifo.h ****  * Write/Read "index" is always in the range of: 0 .. 2*depth-1
  46:libs/tinyusb/common/tusb_fifo.h ****  *
  47:libs/tinyusb/common/tusb_fifo.h ****  * The extra window allow us to determine the fifo state of empty or full with only 2 indices
  48:libs/tinyusb/common/tusb_fifo.h ****  * Following are examples with depth = 3
  49:libs/tinyusb/common/tusb_fifo.h ****  *
  50:libs/tinyusb/common/tusb_fifo.h ****  * - empty: W = R
  51:libs/tinyusb/common/tusb_fifo.h ****  *                |
  52:libs/tinyusb/common/tusb_fifo.h ****  *    -------------------------
  53:libs/tinyusb/common/tusb_fifo.h ****  *    | 0 | RW| 2 | 3 | 4 | 5 |
  54:libs/tinyusb/common/tusb_fifo.h ****  *
  55:libs/tinyusb/common/tusb_fifo.h ****  * - full 1: W > R
  56:libs/tinyusb/common/tusb_fifo.h ****  *                |
  57:libs/tinyusb/common/tusb_fifo.h ****  *    -------------------------
  58:libs/tinyusb/common/tusb_fifo.h ****  *    | 0 | R | 2 | 3 | W | 5 |
  59:libs/tinyusb/common/tusb_fifo.h ****  *
  60:libs/tinyusb/common/tusb_fifo.h ****  * - full 2: W < R
  61:libs/tinyusb/common/tusb_fifo.h ****  *                |
  62:libs/tinyusb/common/tusb_fifo.h ****  *    -------------------------
  63:libs/tinyusb/common/tusb_fifo.h ****  *    | 0 | 1 | W | 3 | 4 | R |
  64:libs/tinyusb/common/tusb_fifo.h ****  *
  65:libs/tinyusb/common/tusb_fifo.h ****  * - Number of items in the fifo can be determined in either cases:
  66:libs/tinyusb/common/tusb_fifo.h ****  *    - case W >= R: Count = W - R
  67:libs/tinyusb/common/tusb_fifo.h ****  *    - case W <  R: Count = 2*depth - (R - W)
ARM GAS  /tmp//cchtNR0e.s 			page 83


  68:libs/tinyusb/common/tusb_fifo.h ****  *
  69:libs/tinyusb/common/tusb_fifo.h ****  * In non-overwritable mode, computed Count (in above 2 cases) is at most equal to depth.
  70:libs/tinyusb/common/tusb_fifo.h ****  * However, in over-writable mode, write index can be repeatedly increased and count can be
  71:libs/tinyusb/common/tusb_fifo.h ****  * temporarily larger than depth (overflowed condition) e.g
  72:libs/tinyusb/common/tusb_fifo.h ****  *
  73:libs/tinyusb/common/tusb_fifo.h ****  *  - Overflowed 1: write(3), write(1)
  74:libs/tinyusb/common/tusb_fifo.h ****  *    In this case we will adjust Read index when read()/peek() is called so that count = depth.
  75:libs/tinyusb/common/tusb_fifo.h ****  *                  |
  76:libs/tinyusb/common/tusb_fifo.h ****  *      -------------------------
  77:libs/tinyusb/common/tusb_fifo.h ****  *      | R | 1 | 2 | 3 | W | 5 |
  78:libs/tinyusb/common/tusb_fifo.h ****  *
  79:libs/tinyusb/common/tusb_fifo.h ****  *  - Double Overflowed i.e index is out of allowed range [0,2*depth)
  80:libs/tinyusb/common/tusb_fifo.h ****  *    This occurs when we continue to write after 1st overflowed to 2nd overflowed. e.g:
  81:libs/tinyusb/common/tusb_fifo.h ****  *      write(3), write(1), write(2)
  82:libs/tinyusb/common/tusb_fifo.h ****  *    This must be prevented since it will cause unrecoverable state, in above example
  83:libs/tinyusb/common/tusb_fifo.h ****  *    if not handled the fifo will be empty instead of continue-to-be full. Since we must not modif
  84:libs/tinyusb/common/tusb_fifo.h ****  *    read index in write() function, which cause race condition. We will re-position write index s
  85:libs/tinyusb/common/tusb_fifo.h ****  *    after data is written it is a full fifo i.e W = depth - R
  86:libs/tinyusb/common/tusb_fifo.h ****  *
  87:libs/tinyusb/common/tusb_fifo.h ****  *      re-position W = 1 before write(2)
  88:libs/tinyusb/common/tusb_fifo.h ****  *      Note: we should also move data from mem[3] to read index as well, but deliberately skipped 
  89:libs/tinyusb/common/tusb_fifo.h ****  *      since it is an expensive operation !!!
  90:libs/tinyusb/common/tusb_fifo.h ****  *                  |
  91:libs/tinyusb/common/tusb_fifo.h ****  *      -------------------------
  92:libs/tinyusb/common/tusb_fifo.h ****  *      | R | W | 2 | 3 | 4 | 5 |
  93:libs/tinyusb/common/tusb_fifo.h ****  *
  94:libs/tinyusb/common/tusb_fifo.h ****  *      perform write(2), result is still a full fifo.
  95:libs/tinyusb/common/tusb_fifo.h ****  *
  96:libs/tinyusb/common/tusb_fifo.h ****  *                  |
  97:libs/tinyusb/common/tusb_fifo.h ****  *      -------------------------
  98:libs/tinyusb/common/tusb_fifo.h ****  *      | R | 1 | 2 | W | 4 | 5 |
  99:libs/tinyusb/common/tusb_fifo.h ****  */
 100:libs/tinyusb/common/tusb_fifo.h **** typedef struct {
 101:libs/tinyusb/common/tusb_fifo.h ****   uint8_t *buffer;              // buffer pointer
 102:libs/tinyusb/common/tusb_fifo.h ****   uint16_t depth;               // max items
 103:libs/tinyusb/common/tusb_fifo.h ****   bool     overwritable;        // overwritable when full
 104:libs/tinyusb/common/tusb_fifo.h ****   // 1 byte padding here
 105:libs/tinyusb/common/tusb_fifo.h **** 
 106:libs/tinyusb/common/tusb_fifo.h ****   volatile uint16_t wr_idx;     // write index
 107:libs/tinyusb/common/tusb_fifo.h ****   volatile uint16_t rd_idx;     // read index
 108:libs/tinyusb/common/tusb_fifo.h **** 
 109:libs/tinyusb/common/tusb_fifo.h **** #if OSAL_MUTEX_REQUIRED
 110:libs/tinyusb/common/tusb_fifo.h ****   osal_mutex_t mutex_wr;
 111:libs/tinyusb/common/tusb_fifo.h ****   osal_mutex_t mutex_rd;
 112:libs/tinyusb/common/tusb_fifo.h **** #endif
 113:libs/tinyusb/common/tusb_fifo.h **** } tu_fifo_t;
