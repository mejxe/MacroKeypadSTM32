1681:libs/tinyusb/device/usbd.c ****   // Clear STALLED|BUSY unconditionally (long-standing behavior; some classes, e.g. audio's
1682:libs/tinyusb/device/usbd.c ****   // set-interface, call this on a non-stalled endpoint solely to drop a leftover BUSY bit).
1683:libs/tinyusb/device/usbd.c ****   // Only release the CLAIMED ownership bit when the endpoint was actually stalled: the stall
1684:libs/tinyusb/device/usbd.c ****   // aborts the in-flight transfer in the dcd with no completion event to release the claim, so
1685:libs/tinyusb/device/usbd.c ****   // clearing it here prevents starvation. On a non-stalled clear (e.g. a data-toggle reset) a
1686:libs/tinyusb/device/usbd.c ****   // transfer may still be legitimately claimed by another task, so keep CLAIMED to preserve the
1687:libs/tinyusb/device/usbd.c ****   // claim->xfer mutual exclusion.
1688:libs/tinyusb/device/usbd.c ****   uint8_t clear_mask = TU_EDPT_STATE_STALLED | TU_EDPT_STATE_BUSY;
