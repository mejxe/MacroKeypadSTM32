 527:libs/tinyusb/device/usbd.c ****     case TUSB_SPEED_HIGH:
 528:libs/tinyusb/device/usbd.c ****       speed_str = "High";
 529:libs/tinyusb/device/usbd.c ****     break;
 530:libs/tinyusb/device/usbd.c ****     case TUSB_SPEED_FULL:
 531:libs/tinyusb/device/usbd.c ****       speed_str = "Full";
 532:libs/tinyusb/device/usbd.c ****     break;
 533:libs/tinyusb/device/usbd.c ****     case TUSB_SPEED_LOW:
 534:libs/tinyusb/device/usbd.c ****       speed_str = "Low";
 535:libs/tinyusb/device/usbd.c ****     break;
 536:libs/tinyusb/device/usbd.c ****     case TUSB_SPEED_AUTO:
 537:libs/tinyusb/device/usbd.c ****       speed_str = "Auto";
 538:libs/tinyusb/device/usbd.c ****     break;
 539:libs/tinyusb/device/usbd.c ****   default:
 540:libs/tinyusb/device/usbd.c ****     break;
 541:libs/tinyusb/device/usbd.c ****   }
 542:libs/tinyusb/device/usbd.c ****   TU_LOG_USBD("USBD init on controller %u, speed = %s\r\n", rhport, speed_str);
 543:libs/tinyusb/device/usbd.c ****   TU_LOG_INT(CFG_TUD_LOG_LEVEL, sizeof(usbd_device_t));
 544:libs/tinyusb/device/usbd.c ****   TU_LOG_INT(CFG_TUD_LOG_LEVEL, sizeof(dcd_event_t));
