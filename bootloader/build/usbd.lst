  20:libs/tinyusb/common/tusb_fifo.h **** // Configuration
  21:libs/tinyusb/common/tusb_fifo.h **** //--------------------------------------------------------------------+
  22:libs/tinyusb/common/tusb_fifo.h **** // mutex is only needed for RTOS. For OS None, we don't get preempted
  23:libs/tinyusb/common/tusb_fifo.h **** #define CFG_FIFO_MUTEX      OSAL_MUTEX_REQUIRED
  24:libs/tinyusb/common/tusb_fifo.h **** 
  25:libs/tinyusb/common/tusb_fifo.h **** #define CFG_TUSB_FIFO_HWFIFO_API (CFG_TUD_EDPT_DEDICATED_HWFIFO || CFG_TUH_EDPT_DEDICATED_HWFIFO)
  26:libs/tinyusb/common/tusb_fifo.h **** 
  27:libs/tinyusb/common/tusb_fifo.h **** #ifndef CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE
  28:libs/tinyusb/common/tusb_fifo.h ****   #define CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE 0
  29:libs/tinyusb/common/tusb_fifo.h **** #endif
  30:libs/tinyusb/common/tusb_fifo.h **** 
  31:libs/tinyusb/common/tusb_fifo.h **** #ifndef CFG_TUSB_FIFO_HWFIFO_ADDR_STRIDE
