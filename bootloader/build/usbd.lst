 556:libs/tinyusb/device/usbd.c ****   _usbd_mutex = osal_mutex_create(&_ubsd_mutexdef);
 557:libs/tinyusb/device/usbd.c ****   TU_ASSERT(_usbd_mutex);
 558:libs/tinyusb/device/usbd.c **** #endif
 559:libs/tinyusb/device/usbd.c **** 
 560:libs/tinyusb/device/usbd.c ****   // Init device queue & task
