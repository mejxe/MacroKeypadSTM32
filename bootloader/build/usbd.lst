 364:libs/tinyusb/device/usbd.c **** // Additional class drivers implemented by application
 365:libs/tinyusb/device/usbd.c **** static const usbd_class_driver_t *_app_driver = NULL;
 366:libs/tinyusb/device/usbd.c **** static const uint8_t _builtin_driver_count    = TU_ARRAY_SIZE(_usbd_driver);
 367:libs/tinyusb/device/usbd.c **** static uint8_t              _app_driver_count = 0;
 368:libs/tinyusb/device/usbd.c **** 
 369:libs/tinyusb/device/usbd.c **** #define TOTAL_DRIVER_COUNT    ((uint8_t) (_app_driver_count + _builtin_driver_count))
 370:libs/tinyusb/device/usbd.c **** 
 371:libs/tinyusb/device/usbd.c **** // virtually joins built-in and application drivers together.
 372:libs/tinyusb/device/usbd.c **** // Application is positioned first to allow overwriting built-in ones.
 373:libs/tinyusb/device/usbd.c **** TU_ATTR_ALWAYS_INLINE static inline usbd_class_driver_t const * get_driver(uint8_t drvid) {
 374:libs/tinyusb/device/usbd.c ****   usbd_class_driver_t const *driver = NULL;
 375:libs/tinyusb/device/usbd.c ****   if (drvid < _app_driver_count) {
 376:libs/tinyusb/device/usbd.c ****     // Application drivers
 377:libs/tinyusb/device/usbd.c ****     driver = &_app_driver[drvid];
 378:libs/tinyusb/device/usbd.c ****   } else{
 379:libs/tinyusb/device/usbd.c ****     drvid -= _app_driver_count;
 380:libs/tinyusb/device/usbd.c ****     if (_builtin_driver_count > 0 && drvid < _builtin_driver_count) {
 381:libs/tinyusb/device/usbd.c ****       driver = &_usbd_driver[drvid];
 382:libs/tinyusb/device/usbd.c ****     }
 383:libs/tinyusb/device/usbd.c ****   }
 384:libs/tinyusb/device/usbd.c **** 
 385:libs/tinyusb/device/usbd.c ****   return driver;
 386:libs/tinyusb/device/usbd.c **** }
