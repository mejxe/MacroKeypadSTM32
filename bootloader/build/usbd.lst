1266:libs/tinyusb/device/usbd.c ****     }
1267:libs/tinyusb/device/usbd.c **** 
1268:libs/tinyusb/device/usbd.c ****     TU_ASSERT(TUSB_DESC_INTERFACE == tu_desc_type(p_desc));
1269:libs/tinyusb/device/usbd.c ****     const tusb_desc_interface_t *desc_itf = (const tusb_desc_interface_t *)p_desc;
1270:libs/tinyusb/device/usbd.c **** 
1271:libs/tinyusb/device/usbd.c ****     // Find driver for this interface
