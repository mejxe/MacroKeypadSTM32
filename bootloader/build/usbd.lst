  18:libs/tinyusb/osal/osal_none.h **** // TASK API
  19:libs/tinyusb/osal/osal_none.h **** //--------------------------------------------------------------------+
  20:libs/tinyusb/osal/osal_none.h **** // Bare-metal single context: return a non-NULL sentinel so equality compares true.
  21:libs/tinyusb/osal/osal_none.h **** typedef void* osal_task_handle_t;
  22:libs/tinyusb/osal/osal_none.h **** 
  23:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline osal_task_handle_t osal_task_get_current_handle(void) {
  24:libs/tinyusb/osal/osal_none.h ****   return (osal_task_handle_t) 1;
  25:libs/tinyusb/osal/osal_none.h **** }
  26:libs/tinyusb/osal/osal_none.h **** 
  27:libs/tinyusb/osal/osal_none.h **** // Bare-metal has no scheduler to yield to; this is dead code in practice because
  28:libs/tinyusb/osal/osal_none.h **** // callers gate it on running outside the host task, which can't happen here.
  29:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_task_delay(uint32_t msec) {
  30:libs/tinyusb/osal/osal_none.h ****   (void) msec;
  31:libs/tinyusb/osal/osal_none.h **** }
  32:libs/tinyusb/osal/osal_none.h **** 
  33:libs/tinyusb/osal/osal_none.h **** //--------------------------------------------------------------------+
  34:libs/tinyusb/osal/osal_none.h **** // Spinlock API
  35:libs/tinyusb/osal/osal_none.h **** //--------------------------------------------------------------------+
  36:libs/tinyusb/osal/osal_none.h **** // Note: This implementation is designed for bare-metal single-core systems without RTOS.
  37:libs/tinyusb/osal/osal_none.h **** // - Supports nested locking within the same execution context
  38:libs/tinyusb/osal/osal_none.h **** // - NOT suitable for true SMP (Symmetric Multi-Processing) systems
  39:libs/tinyusb/osal/osal_none.h **** // - NOT thread-safe for multi-threaded environments
  40:libs/tinyusb/osal/osal_none.h **** // - Primarily manages interrupt enable/disable state for critical sections
  41:libs/tinyusb/osal/osal_none.h **** typedef struct {
ARM GAS  /tmp//cchtNR0e.s 			page 67


  42:libs/tinyusb/osal/osal_none.h ****   void (* interrupt_set)(bool enabled);
  43:libs/tinyusb/osal/osal_none.h ****   uint32_t nested_count;
  44:libs/tinyusb/osal/osal_none.h **** } osal_spinlock_t;
  45:libs/tinyusb/osal/osal_none.h **** 
  46:libs/tinyusb/osal/osal_none.h **** // For SMP, spinlock must be locked by hardware, cannot just use interrupt
  47:libs/tinyusb/osal/osal_none.h **** #define OSAL_SPINLOCK_DEF(_name, _int_set) \
  48:libs/tinyusb/osal/osal_none.h ****   osal_spinlock_t _name = { .interrupt_set = _int_set, .nested_count = 0 }
  49:libs/tinyusb/osal/osal_none.h **** 
  50:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_init(osal_spinlock_t *ctx) {
  51:libs/tinyusb/osal/osal_none.h ****   (void) ctx;
  52:libs/tinyusb/osal/osal_none.h **** }
  53:libs/tinyusb/osal/osal_none.h **** 
  54:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_deinit(osal_spinlock_t *ctx) {
  55:libs/tinyusb/osal/osal_none.h ****   (void) ctx;
  56:libs/tinyusb/osal/osal_none.h **** }
  57:libs/tinyusb/osal/osal_none.h **** 
  58:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_lock(osal_spinlock_t *ctx, bool in_isr) {
  59:libs/tinyusb/osal/osal_none.h ****   // Disable interrupts first to make nested_count increment atomic
  60:libs/tinyusb/osal/osal_none.h ****   if (!in_isr && ctx->nested_count == 0) {
  61:libs/tinyusb/osal/osal_none.h ****     ctx->interrupt_set(false);
  62:libs/tinyusb/osal/osal_none.h ****   }
  63:libs/tinyusb/osal/osal_none.h ****   ctx->nested_count++;
  64:libs/tinyusb/osal/osal_none.h **** }
  65:libs/tinyusb/osal/osal_none.h **** 
  66:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_unlock(osal_spinlock_t *ctx, bool in_isr) {
  67:libs/tinyusb/osal/osal_none.h ****   if (ctx->nested_count == 0) {
  68:libs/tinyusb/osal/osal_none.h ****     return; // spin is not locked to begin with
