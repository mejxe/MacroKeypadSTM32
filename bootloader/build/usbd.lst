1061:libs/tinyusb/device/usbd.c ****   TU_VERIFY(request->bmRequestType_bit.direction == TUSB_DIR_IN);
1062:libs/tinyusb/device/usbd.c ****   return tud_control_xfer(rhport, request, &status, 2);
1063:libs/tinyusb/device/usbd.c **** }
