 141:libs/tinyusb/osal/osal_none.h ****   return osal_semaphore_wait(mutex_hdl, msec);
 142:libs/tinyusb/osal/osal_none.h **** }
 143:libs/tinyusb/osal/osal_none.h **** 
 144:libs/tinyusb/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline bool osal_mutex_unlock(osal_mutex_t mutex_hdl) {
 145:libs/tinyusb/osal/osal_none.h ****   return osal_semaphore_post(mutex_hdl, false);
 146:libs/tinyusb/osal/osal_none.h **** }
