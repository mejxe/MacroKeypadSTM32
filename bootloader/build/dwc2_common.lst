 146:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // MCU specific to enable dwc2 clock/power before any access to register
 147:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** TU_ATTR_ALWAYS_INLINE static inline void dwc2_clock_init(uint8_t rhport, tusb_role_t role) {
 148:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   (void) rhport;
