 152:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** TU_ATTR_ALWAYS_INLINE static inline void dwc2_int_set(uint8_t rhport, tusb_role_t role, bool enable
 153:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   (void) role;
