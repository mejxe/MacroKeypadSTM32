 174:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // MCU specific PHY init, called BEFORE core reset
 175:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // - dwc2 3.30a (H5) use USB_HS_PHYC
 176:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // - dwc2 4.11a (U5) use femtoPHY
 177:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** // - dwc2 x.xxx (WBA) use USB_OTG_HS
 178:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** static inline void dwc2_phy_init(dwc2_regs_t* dwc2, uint8_t hs_phy_type) {
 179:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   if (hs_phy_type == GHWCFG2_HSPHY_NOT_SUPPORTED) {
 180:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     // Enable on-chip FS PHY
