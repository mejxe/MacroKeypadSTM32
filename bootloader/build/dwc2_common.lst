 166:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h **** TU_ATTR_ALWAYS_INLINE static inline void dwc2_remote_wakeup_delay(void) {
 167:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   // try to delay for 1 ms
 168:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   uint32_t count = SystemCoreClock / 1000;
 169:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****   while (count--) {
 170:libs/tinyusb/portable/synopsys/dwc2/dwc2_stm32.h ****     __NOP();
