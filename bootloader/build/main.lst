 187:Core/Src/main.c ****   app_reset_vec = *(volatile uint32_t *)(APP_SECTOR_START + 4);
 188:Core/Src/main.c ****   if (app_stack < 0x20000000 || app_stack > 0x20020000)
 189:Core/Src/main.c ****     return;
 190:Core/Src/main.c ****   app_entry = (func_pointer)app_reset_vec;
 191:Core/Src/main.c **** 
 192:Core/Src/main.c ****   __disable_irq();
 193:Core/Src/main.c **** 
 194:Core/Src/main.c ****   SysTick->CTRL = 0;
 195:Core/Src/main.c ****   SysTick->LOAD = 0;
 196:Core/Src/main.c ****   SysTick->VAL = 0;
 197:Core/Src/main.c ****   HAL_RCC_DeInit();
 198:Core/Src/main.c ****   __set_MSP(app_stack);
 199:Core/Src/main.c **** 
 200:Core/Src/main.c ****   app_entry();
 201:Core/Src/main.c **** }
