 343:Core/Src/main.c **** void deploy_app_task()
 344:Core/Src/main.c **** {
 345:Core/Src/main.c ****   if (!should_copy_to_main_app || Flasher.mode == FlashToUpdateBuffer ||
 346:Core/Src/main.c ****       Flasher.should_flash)
 347:Core/Src/main.c ****     return;
 348:Core/Src/main.c **** 
 349:Core/Src/main.c ****   if (Flasher.mode == Idle)
 350:Core/Src/main.c ****   {
 351:Core/Src/main.c ****     setup_flasher(&Flasher, FlashToAppBuffer);
 352:Core/Src/main.c ****   }
 353:Core/Src/main.c ****   static uint32_t all_read = 0;
 354:Core/Src/main.c ****   uint32_t to_read = (app_size_in_update_buf_B - all_read) > MESSAGE_BUFSIZE
 355:Core/Src/main.c ****                          ? MESSAGE_BUFSIZE
 356:Core/Src/main.c ****                          : app_size_in_update_buf_B - all_read;
 357:Core/Src/main.c ****   memcpy(Flasher.message_buf, (void *)FLASH_UPDATE_BUF + Flasher.flash_offset,
 358:Core/Src/main.c ****          to_read);
 359:Core/Src/main.c **** 
 360:Core/Src/main.c ****   Flasher.in_buffer = to_read;
 361:Core/Src/main.c ****   all_read += to_read;
 362:Core/Src/main.c ****   printf("read from updatebuf: %d\r\n", all_read);
 363:Core/Src/main.c **** 
 364:Core/Src/main.c ****   if (all_read >= app_size_in_update_buf_B)
 365:Core/Src/main.c ****   {
 366:Core/Src/main.c ****     Flasher.should_finish = true;
 367:Core/Src/main.c ****     should_copy_to_main_app = false;
 368:Core/Src/main.c ****     should_restart_after_flash = true;
 369:Core/Src/main.c ****   }
 370:Core/Src/main.c **** }
