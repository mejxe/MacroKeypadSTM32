 271:Core/Src/main.c **** void cdc_task()
 272:Core/Src/main.c **** {
 273:Core/Src/main.c ****   static bool magic_number_read = false;
 274:Core/Src/main.c ****   static uint32_t all_read = 0;
 275:Core/Src/main.c ****   static uint32_t binary_size = 0;
 276:Core/Src/main.c **** 
 277:Core/Src/main.c ****   if (!tud_cdc_available() || Flasher.should_flash ||
 278:Core/Src/main.c ****       Flasher.mode == FlashToAppBuffer)
 279:Core/Src/main.c ****     return;
 280:Core/Src/main.c **** 
 281:Core/Src/main.c ****   uint8_t temp_buf[CFG_TUD_CDC_RX_BUFSIZE];
 282:Core/Src/main.c ****   uint32_t read = tud_cdc_read(temp_buf, 64);
 283:Core/Src/main.c ****   if (!magic_number_read)
 284:Core/Src/main.c ****   {
 285:Core/Src/main.c ****     if (temp_buf[0] == 0x25 && temp_buf[1] == 0x07 && temp_buf[2] == 0xa0 &&
 286:Core/Src/main.c ****         temp_buf[3] == 0x7a)
 287:Core/Src/main.c ****     {
 288:Core/Src/main.c ****       magic_number_read = true;
 289:Core/Src/main.c ****       for (int i = 0; i < 8; i++)
 290:Core/Src/main.c ****       {
 291:Core/Src/main.c ****         binary_size |= (temp_buf[4 + i] << i * 8);
 292:Core/Src/main.c ****       }
 293:Core/Src/main.c ****       for (int i = 0; i < 4; i++)
 294:Core/Src/main.c ****       {
 295:Core/Src/main.c ****         expected_crc_val |= (temp_buf[12 + i] << i * 8);
 296:Core/Src/main.c ****       }
 297:Core/Src/main.c **** 
 298:Core/Src/main.c ****       setup_flasher(&Flasher, FlashToUpdateBuffer);
 299:Core/Src/main.c ****       printf("Read magic number, binary size: %d\r\n", binary_size);
 300:Core/Src/main.c ****       return;
 301:Core/Src/main.c ****     }
 302:Core/Src/main.c ****     else
 303:Core/Src/main.c ****       return;
 304:Core/Src/main.c ****   }
 305:Core/Src/main.c **** 
 306:Core/Src/main.c ****   memcpy(flasher_get_message_buf_pos(&Flasher), temp_buf, read);
 307:Core/Src/main.c ****   Flasher.in_buffer += read;
 308:Core/Src/main.c **** 
 309:Core/Src/main.c ****   printf("in flash: %d\r\n", Flasher.in_buffer);
 310:Core/Src/main.c ****   all_read += read;
 311:Core/Src/main.c **** 
 312:Core/Src/main.c ****   if (all_read >= binary_size)
 313:Core/Src/main.c ****   {
 314:Core/Src/main.c ****     printf("Read %d bytes, finishing\r\n",
 315:Core/Src/main.c ****            all_read +
 316:Core/Src/main.c ****                64); // skipped one single window of headers hence the addition
ARM GAS  /tmp//cc6ckyD3.s 			page 7


 317:Core/Src/main.c ****     Flasher.should_finish = true;
 318:Core/Src/main.c ****     app_size_in_update_buf_B = all_read;
 319:Core/Src/main.c ****     magic_number_read = false;
 320:Core/Src/main.c ****     should_copy_to_main_app = true;
 321:Core/Src/main.c ****   }
 322:Core/Src/main.c **** }
 323:Core/Src/main.c **** 
 324:Core/Src/main.c **** bool delay_non_blocking_ms(uint32_t interval, uint32_t *start_ms)
 325:Core/Src/main.c **** {
 326:Core/Src/main.c ****   if (HAL_GetTick() - *start_ms < interval)
 327:Core/Src/main.c ****   {
