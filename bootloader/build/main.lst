  45:libs/tinyusb/device/usbd.h **** 
  46:libs/tinyusb/device/usbd.h **** // New API to replace tud_init() to init device stack on specific roothub port
  47:libs/tinyusb/device/usbd.h **** // Must be called in the same task/context as tud_task() if RTOS is used
  48:libs/tinyusb/device/usbd.h **** bool tud_rhport_init(uint8_t rhport, const tusb_rhport_init_t* rh_init);
  49:libs/tinyusb/device/usbd.h **** 
