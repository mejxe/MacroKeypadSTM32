 153:Core/Src/main.c **** void write_flash(Flasher_t *flasher)
 154:Core/Src/main.c **** {
 155:Core/Src/main.c ****   uint32_t cast_buffer[MESSAGE_BUFSIZE / 4 + 1];
 156:Core/Src/main.c ****   uint32_t words_to_write = (flasher->in_buffer + 3) / 4;
 157:Core/Src/main.c ****   uint32_t TARGET_FLASH_BUFFER = flasher_get_sector(flasher);
 158:Core/Src/main.c **** 
 159:Core/Src/main.c ****   memcpy(cast_buffer, flasher->message_buf, flasher->in_buffer);
 160:Core/Src/main.c **** 
 161:Core/Src/main.c ****   HAL_CRC_Accumulate(&hcrc, cast_buffer, words_to_write);
 162:Core/Src/main.c **** 
 163:Core/Src/main.c ****   uint32_t words_written = write_buf_to_flash(
 164:Core/Src/main.c ****       TARGET_FLASH_BUFFER + flasher->flash_offset, cast_buffer, words_to_write);
 165:Core/Src/main.c **** 
 166:Core/Src/main.c ****   if (words_written != words_to_write)
 167:Core/Src/main.c ****   {
 168:Core/Src/main.c ****     Error_Handler();
 169:Core/Src/main.c ****     return;
 170:Core/Src/main.c ****   }
 171:Core/Src/main.c ****   flasher->flash_offset += words_written * 4;
 172:Core/Src/main.c **** }
