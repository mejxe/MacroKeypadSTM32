 203:Core/Src/main.c **** // returns how much written
 204:Core/Src/main.c **** uint32_t write_buf_to_flash(uint32_t flash_address, uint32_t *buf,
 205:Core/Src/main.c ****                             uint32_t bufsize)
 206:Core/Src/main.c **** {
 207:Core/Src/main.c ****   uint32_t number_of_words = bufsize;
 208:Core/Src/main.c ****   uint32_t written_words = 0;
 209:Core/Src/main.c **** 
 210:Core/Src/main.c ****   while (written_words < number_of_words)
 211:Core/Src/main.c ****   {
 212:Core/Src/main.c ****     if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, flash_address,
 213:Core/Src/main.c ****                           buf[written_words]) == HAL_OK)
 214:Core/Src/main.c ****     {
 215:Core/Src/main.c ****       written_words++;
 216:Core/Src/main.c ****       flash_address += sizeof(*buf);
 217:Core/Src/main.c ****     }
 218:Core/Src/main.c ****     else
 219:Core/Src/main.c ****     {
 220:Core/Src/main.c ****       /* Error occurred while writing data in Flash memory*/
 221:Core/Src/main.c ****       HAL_FLASH_Lock();
 222:Core/Src/main.c ****       return HAL_FLASH_GetError();
 223:Core/Src/main.c ****     }
 224:Core/Src/main.c ****   }
 225:Core/Src/main.c ****   return written_words;
 226:Core/Src/main.c **** }
 227:Core/Src/main.c **** 
 228:Core/Src/main.c **** uint32_t setup_flasher(Flasher_t *f, FlasherMode mode)
 229:Core/Src/main.c **** {
 230:Core/Src/main.c ****   static FLASH_EraseInitTypeDef EraseInitStruct;
 231:Core/Src/main.c ****   uint32_t SECTORError;
 232:Core/Src/main.c ****   uint8_t sector;
 233:Core/Src/main.c ****   uint8_t nb_sectors;
 234:Core/Src/main.c **** 
 235:Core/Src/main.c ****   switch (mode)
 236:Core/Src/main.c ****   {
 237:Core/Src/main.c ****   case Idle:
 238:Core/Src/main.c ****     return 101;
 239:Core/Src/main.c ****     break;
 240:Core/Src/main.c ****   case FlashToAppBuffer:
 241:Core/Src/main.c ****     sector = FLASH_SECTOR_4;
 242:Core/Src/main.c ****     nb_sectors = 3;
 243:Core/Src/main.c ****     break;
 244:Core/Src/main.c ****   case FlashToUpdateBuffer:
 245:Core/Src/main.c ****     sector = FLASH_SECTOR_7;
 246:Core/Src/main.c ****     nb_sectors = 1;
 247:Core/Src/main.c ****     break;
 248:Core/Src/main.c ****   }
 249:Core/Src/main.c **** 
 250:Core/Src/main.c ****   /* Unlock the Flash to enable the flash control register access *************/
 251:Core/Src/main.c ****   HAL_FLASH_Unlock();
 252:Core/Src/main.c **** 
 253:Core/Src/main.c ****   /* Fill EraseInit structure*/
 254:Core/Src/main.c ****   EraseInitStruct.TypeErase = FLASH_TYPEERASE_SECTORS;
 255:Core/Src/main.c ****   EraseInitStruct.VoltageRange = FLASH_VOLTAGE_RANGE_3;
 256:Core/Src/main.c ****   EraseInitStruct.Sector = sector;
 257:Core/Src/main.c ****   EraseInitStruct.NbSectors = nb_sectors;
 258:Core/Src/main.c **** 
 259:Core/Src/main.c ****   if (HAL_FLASHEx_Erase(&EraseInitStruct, &SECTORError) != HAL_OK)
ARM GAS  /tmp//cc6ckyD3.s 			page 6


 260:Core/Src/main.c ****   {
 261:Core/Src/main.c ****     HAL_FLASH_Lock();
 262:Core/Src/main.c ****     return HAL_FLASH_GetError();
 263:Core/Src/main.c ****   }
 264:Core/Src/main.c ****   f->flash_ready = true;
 265:Core/Src/main.c ****   f->mode = mode;
 266:Core/Src/main.c **** 
 267:Core/Src/main.c ****   __HAL_CRC_DR_RESET(&hcrc);
 268:Core/Src/main.c ****   return 0;
 269:Core/Src/main.c **** }
