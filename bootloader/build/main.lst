 106:Core/Src/main.c **** void flash_task()
 107:Core/Src/main.c **** {
 108:Core/Src/main.c ****   if (!Flasher.flash_ready)
 109:Core/Src/main.c ****     return;
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****   if (Flasher.should_flash)
 112:Core/Src/main.c ****   {
 113:Core/Src/main.c ****     printf("Writing to flash buffer\r\n");
 114:Core/Src/main.c ****     write_flash(&Flasher);
 115:Core/Src/main.c ****     printf("Written to flash buffer\r\n");
 116:Core/Src/main.c ****     Flasher.should_flash = false;
 117:Core/Src/main.c ****     Flasher.in_buffer = 0;
 118:Core/Src/main.c ****   }
 119:Core/Src/main.c ****   else if (Flasher.should_finish)
 120:Core/Src/main.c ****   {
 121:Core/Src/main.c ****     finish_flash(&Flasher);
 122:Core/Src/main.c ****   }
 123:Core/Src/main.c ****   else if (Flasher.in_buffer >= MESSAGE_BUFSIZE)
 124:Core/Src/main.c ****   {
 125:Core/Src/main.c ****     Flasher.should_flash = true;
 126:Core/Src/main.c ****   }
 127:Core/Src/main.c **** }
 128:Core/Src/main.c **** void finish_flash(Flasher_t *flasher)
 129:Core/Src/main.c **** {
 130:Core/Src/main.c ****   if (Flasher.in_buffer != 0)
 131:Core/Src/main.c ****   {
 132:Core/Src/main.c ****     Flasher.should_flash = true;
 133:Core/Src/main.c ****     printf("Finishing flash\r\n");
 134:Core/Src/main.c ****     return;
 135:Core/Src/main.c ****   }
 136:Core/Src/main.c ****   Flasher.in_buffer = 0;
 137:Core/Src/main.c ****   Flasher.should_flash = false;
 138:Core/Src/main.c ****   Flasher.should_finish = false;
 139:Core/Src/main.c ****   Flasher.mode = Idle;
 140:Core/Src/main.c ****   Flasher.flash_offset = 0;
 141:Core/Src/main.c ****   HAL_FLASH_Lock();
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****   if (!compare_crc_val())
 144:Core/Src/main.c ****   {
 145:Core/Src/main.c ****     printf("CRC Value mismatch, flash aborted, try again.\n\r");
ARM GAS  /tmp//cc6ckyD3.s 			page 4


 146:Core/Src/main.c ****     should_copy_to_main_app = false;
 147:Core/Src/main.c ****     should_restart_after_flash = true;
 148:Core/Src/main.c ****   }
 149:Core/Src/main.c **** 
 150:Core/Src/main.c ****   printf("Finished flash\r\n");
 151:Core/Src/main.c **** }
