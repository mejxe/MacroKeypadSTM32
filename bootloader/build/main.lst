  51:libs/tinyusb/device/usbd.h **** #if TUSB_VERSION_NUMBER > 2000  // 0.20.0
  52:libs/tinyusb/device/usbd.h **** TU_ATTR_DEPRECATED("Please use tusb_init(rhport, rh_init) instead")
  53:libs/tinyusb/device/usbd.h **** #endif
  54:libs/tinyusb/device/usbd.h **** TU_ATTR_ALWAYS_INLINE static inline bool tud_init (uint8_t rhport) {
  55:libs/tinyusb/device/usbd.h ****   const tusb_rhport_init_t rh_init = {
  56:libs/tinyusb/device/usbd.h ****     .role = TUSB_ROLE_DEVICE,
  57:libs/tinyusb/device/usbd.h ****     .speed = TUD_OPT_HIGH_SPEED ? TUSB_SPEED_HIGH : TUSB_SPEED_FULL
  58:libs/tinyusb/device/usbd.h ****   };
  59:libs/tinyusb/device/usbd.h ****   return tud_rhport_init(rhport, &rh_init);
  60:libs/tinyusb/device/usbd.h **** }
  61:libs/tinyusb/device/usbd.h **** 
